	author = {Wei, Wenli and Lin, Jenchun and Liu, Tyng-Luh and Yang, Yi-Hsuan and Wang, Hsin-Min and Tyan, Hsiaorong and Liao, Hong Yuan Mark},
	title = {Deep-net fusion to classify shots in concert videos},
	year = {2017},
	journal = {Proceedings - ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing},
