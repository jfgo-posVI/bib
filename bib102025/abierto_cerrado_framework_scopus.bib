}

@ARTICLE{Pitt20212080,
	author = {Pitt, Kevin M. and McCarthy, John W.},
	title = {What’s in a photograph? The perspectives of composition experts on factors impacting visual scene display complexity for augmentative and alternative communication and strategies for improving visual communication},
	year = {2021},
	journal = {American Journal of Speech-Language Pathology},
	volume = {30},
