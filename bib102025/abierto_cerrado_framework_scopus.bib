@CONFERENCE{Hsu20207952,
	author = {Hsu, Chaochun and Chen, Ziyuan and Hsu, Chiyang and Li, Chihchia and Lin, Tzu Yuan and Huang, Ting Hao ‘Kenneth’ and Ku, Lunwei},
	title = {Knowledge-enriched visual storytelling},
	year = {2020},
	pages = {7952 - 7960},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85106444249&partnerID=40&md5=72427107afbb166f41c425fef0a5158f},
	affiliations = {University of Colorado Boulder, Boulder, United States; Academia Sinica Taiwan, Nankang, Taiwan; Pennsylvania State University, University Park, United States; National Chiao Tung University, Hsinchu, Taiwan; National Taiwan University, Taipei, Taiwan; All Vista Healthcare, Vista, United States},
	abstract = {Stories are diverse and highly personalized, resulting in a large possible output space for story generation. Existing end-to-end approaches produce monotonous stories because they are limited to the vocabulary and knowledge in a single training dataset. This paper introduces KG-Story, a three-stage framework that allows the story generation model to take advantage of external Knowledge Graphs to produce interesting stories. KG-Story distills a set of representative words from the input prompts, enriches the word set by using external knowledge graphs, and finally generates stories based on the enriched word set. This distill-enrich-generate framework allows the use of external resources not only for the enrichment phase, but also for the distillation and generation phases. In this paper, we show the superiority of KG-Story for visual storytelling, where the input prompt is a sequence of five photos and the output is a short story. Per the human ranking evaluation, stories generated by KG-Story are on average ranked better than that of the state-of-the-art systems. Our code and output stories are available at https://github.com/zychen423/KE-VIST. © 2021 Elsevier B.V., All rights reserved.},
	keywords = {Distillation; End to end; External knowledge; External resources; State-of-the-art system; Story generations; Training dataset; Visual storytellings; Knowledge representation},
	correspondence_address = {C.-C. Hsu; University of Colorado Boulder, United States; email: chao-chun.hsu@colorado.edu; Z.-Y. Chen; Academia Sinica; email: zychen@iis.sinica.edu.tw},
	publisher = {AAAI press},
	isbn = {9781577358350},
	language = {English},
	abbrev_source_title = {AAAI - AAAI Conf. Artif. Intell.},
	type = {Conference paper},
