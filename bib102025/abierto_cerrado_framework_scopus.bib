	year = {2019},
	journal = {Communications in Computer and Information Science},
	volume = {1057 CCIS},
	pages = {272 - 283},
	doi = {10.1007/978-3-030-36599-8_24},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077010115&doi=10.1007%2F978-3-030-36599-8_24&partnerID=40&md5=a5ddbc633407bbe464fa2aaecc47c37e},
	affiliations = {Universita degli Studi Guglielmo Marconi, Rome, Italy; Leibniz Institute for Educational Media | Georg Eckert Institute (GEI), Braunschweig, Germany; Università di Pisa, Pisa, Italy; Universita degli Studi Guglielmo Marconi, Rome, Italy},
	abstract = {In recent years, many data visualization tools have appeared on the market that can potentially guarantee citizens and users of the Public Administration (PA) the ability to create dashboards and data stories with just a few clicks, using open and unopened data from the PA. The Data Analytics Framework (DAF), a project of the Italian government launched at the end of 2017 and currently being tested, has the goal to improve and simplify the interoperability and exchange of data between Public Administrations, thanks to its big data platform and the integrated use of data visualization tools and semantic technologies. The DAF also has the objective of facilitating data analysis, improving the management of Open Data and facilitating the spread of linked open data (LOD) thanks to the integration of OntoPiA, a network of controlled vocabularies and ontologies, such as “IoT Events”, an ontology for representing and modelling the knowledge within the domain of the Internet of Things. This paper contributes to the enhancement of the project by introducing a case study created by the author, concerns tourism of Sardinia (a region of Italy). The case study follows a process in the DAF in 5 steps, starting from selection of the dataset to the creation phase of the real dashboard through Apache Superset (a business intelligence tool) and the related data story. This case study is one of the few demonstrations of use on a real case of DAF and highlights the ability of this national platform to transform the analysis of a large amount of data into simple visual representations with clear and effective language. © 2019 Elsevier B.V., All rights reserved.},
	author_keywords = {Business intelligence; Dashboard; Data & Analytics Framework; Data visualization; Open data},
	keywords = {Competitive intelligence; Data Analytics; Data visualization; Information analysis; Information management; Internet of things; Interoperability; Metadata; Ontology; Public administration; Semantics; Visual languages; Visualization; Dashboard; Data platform; Data visualization tools; Integrated use; Large amounts; Linked open data (LOD); Semantic technologies; Visual representations; Open Data},
	editor = {Garoufallou, E. and Fallucchi, F. and William De Luca, E.},
