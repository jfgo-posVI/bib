	keywords = {Data storytelling; Human-artificial intelligence collaboration; Interview study; Levels of automation; Public communications; Research trends; Team collaboration; Work-flows; Workers'; adult; artificial intelligence; computer graphics; cooperation; female; human; interpersonal communication; interview; male; middle aged; verbal communication; Adult; Artificial Intelligence; Communication; Computer Graphics; Cooperative Behavior; Female; Humans; Interviews as Topic; Male; Middle Aged; Narration},
