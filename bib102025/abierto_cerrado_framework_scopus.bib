@ARTICLE{Annabell2024,
	author = {Annabell, Taylor and Rasmussen, Nina Vindum},
	title = {Spotify (Un)wrapped: how ordinary users critically reflect on Spotify’s datafication of the self within creative workshops},
	year = {2024},
	journal = {Journal of Gender Studies},
	pages = {},
	doi = {10.1080/09589236.2024.2433674},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210471131&doi=10.1080%2F09589236.2024.2433674&partnerID=40&md5=7e7cbf009410fd5955b8b15b87aef863},
	affiliations = {Universiteit Utrecht, Faculty of Law, Utrecht, Netherlands; London School of Economics and Political Science, London, United Kingdom},
	abstract = {Each year, Spotify nudges users to share aesthetically pleasing data stories ‘wrapped’ and repackaged from their listening behavior. This article approaches Spotify Wrapped as an annual algorithmic event, defined as a moment in time in which there is a collective orientation towards a particular algorithmic system and its associated data. It offers a methodological contribution to research on datafication of music taste and identities through the development of a workshop format aimed at ordinary Spotify users. The workshop delivers insights into practices of datafication and the normative assumptions baked into Spotify data stories. Drawing on a data feminist framework, we outline three interconnected but distinct creative exercises, which take participants on an analytical journey. We combine feminist arts-based research methodologies with critical reflection and the walkthrough method to centre people’s experiences and equip them to analyze different layers of Wrapped. Our theoretical and methodological approach seeks to destabilize the logics of data extraction that further Spotify’s commercial aims and its associated claims of ‘knowing us’ through the aggregation of user data. As such, our workshop transforms the marketing campaign into a site for critical reflection on Wrapped as an algorithmic event. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Algorithmic culture; algorithmic events; creative methods; datafication; Spotify},
	keywords = {art; article; cultural anthropology; data extraction; diagnosis; exercise; feminism; human; marketing; music; workshop},
	correspondence_address = {T. Annabell; Faculty of Law, Economics and Governance, Utrecht University, Netherlands; email: t.annabell@uu.nl},
	publisher = {Routledge},
	issn = {09589236; 14653869},
	language = {English},
	abbrev_source_title = {J. Gender Stud.},
	type = {Article},
	publication_stage = {aip},
