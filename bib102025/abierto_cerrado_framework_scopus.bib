@ARTICLE{Spindler2008109,
	author = {Spindler, Martin and Voß, Gerrit and Müller-Wittig, Wolfgang K.},
	title = {Interactive multi-perspective rendering via ray-tracing},
	year = {2008},
	pages = {109 - 116},
	doi = {10.5176/978-981-08-8227-3_cgat08-16},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84857076426&doi=10.5176%2F978-981-08-8227-3_cgat08-16&partnerID=40&md5=01f0c33435489f915844fa336a2c11f2},
	affiliations = {Nanyang Technological University, Centre for Advanced Media Technology, Singapore City, Singapore},
	abstract = {The pinhole camera is a widely used tool in three-dimensional computer games. It collects light rays that cross a single focus point. Due to its linear properties, single-perspective cameras can easily be incorporated into polygon-based rendering pipelines (as found on common graphics hardware). Multi-perspective cameras, in contrast, do not require that rays of light pass through a single focus point. Instead, they collect rays of light across a multiple number of focus points and thus generate images of non-linear perspective. One traditional rendering method for multi-perspective images is ray tracing. Although ray tracing is a powerful technique that is thoroughly understood, until recently, it was not applicable for real-time applications. With the advent of real-time/interactive ray tracers, this situation has changed considerably. In this paper, we describe our approach to an interactive multi-perspective rendering framework that is based on a real-time ray-tracer. We also provide a graphical user interface that allows a user to define multi-perspective cameras. Although our work can be considered experimental, we believe that multi-perspective images are a powerful, yet still unexplored tool that might help bring the visual storytelling in computer games to the next level. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Multi-Perspective images; Non-Linear projections; Real-Time ray-tracing; Scene graph},
	keywords = {Animation; Computer games; Graphical user interfaces; IPTV; Pinhole cameras; Ray tracing; Multi-perspective image; Nonlinear projections; Perspective cameras; Real time; Real-time application; Rendering pipelines; Scene graph; Visual storytellings; Rendering (computer graphics)},
	publisher = {Computer Games, Multimedia and Allied Technology (CGAT) info@cgames.com.sg},
	isbn = {9789810806934},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
