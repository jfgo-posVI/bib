	author = {Alliata, Giacomo and Kenderdine, Sarah and Hibberd, Lily and Mason, Ingrid},
	title = {Towards Immersive Generosity: The Need for a Novel Framework to Explore Large Audiovisual Archives through Embodied Experiences in Immersive Environments},
