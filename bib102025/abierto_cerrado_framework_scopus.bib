	author = {Hsu, Chiyang and Chu, Yunwei and Huang, Ting Hao ‘Kenneth’ and Ku, Lunwei},
	title = {Plot and Rework: Modeling Storylines for Visual Storytelling},
	year = {2021},
	pages = {4443 - 4453},
	doi = {10.18653/v1/2021.findings-acl.390},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123928682&doi=10.18653%2Fv1%2F2021.findings-acl.390&partnerID=40&md5=f152860ca132e566f76a83088e372b69},
	affiliations = {Pennsylvania State University, University Park, United States; Purdue University, West Lafayette, United States; Institute of Information Science, Academia Sinica, Taipei, Taiwan},
	abstract = {Writing a coherent and engaging story is not easy. Creative writers use their knowledge and worldview to put disjointed elements together to form a coherent storyline, and work and rework iteratively toward perfection. Automated visual storytelling (VIST) models, however, make poor use of external knowledge and iterative generation when attempting to create stories. This paper introduces PR-VIST, a framework that represents the input image sequence as a story graph in which it finds the best path to form a storyline. PR-VIST then takes this path and learns to generate the final story via a re-evaluating training process. This framework produces stories that are superior in terms of diversity, coherence, and humanness, per both automatic and human evaluations. An ablation study shows that both plotting and reworking contribute to the model's superiority. © 2024 Elsevier B.V., All rights reserved.},
