	affiliations = {Chongqing Technology and Business Institute, College of Media and Design, Chongqing, China; UCSI University, Faculty of Social Sciences and Liberal Arts, Kuala Lumpur, Malaysia},
	abstract = {A movie or TV script is a meticulously crafted document that serves as the blueprint for a visual storytelling project. It outlines the dialogue, actions, and scene descriptions that will unfold on screen, guiding actors, directors, and crew members in bringing the story to life. Each script is divided into scenes and acts, with clear instructions on character entrances and exits, camera angles, and pacing. This paper introduces a novel framework for enhancing the quality of movie and TV scripts through the integration of the Combinational Multi-Stage Genetic Optimization (CMSGO) model with ChatGPT, a state-of-the-art language generation model. The CMSGO model utilizes iterative optimization techniques to systematically refine and enhance script elements such as coherence, dialogue flow, character development, and overall narrative structure. The proposed CMSGO model comprises the Combinational model with the genetic optimization function. The function CMSGO model examines the fitness function with the Multi-Stage Optimization process. The proposed CMSGO model uses the estimation of features in the Multi-stage optimization model with the computation of features related to the scripts. Through 20 generations of optimization, the CMSGO model demonstrates its effectiveness in improving script quality, as evidenced by a steady increase in average script quality scores. Additionally, the multi-stage optimization approach targets specific aspects of script quality, allowing for targeted adjustments to parameters related to character motivations, plot coherence, and tone. Viewer opinions further validate the efficacy of the generated scripts, with positive evaluations across various aspects such as audience engagement, coherence, emotional impact, and originality. The proposed framework offers a robust and data-driven approach to scriptwriting, enabling the creation of high-quality movie and TV scripts that captivate and resonate with audiences, thus enriching the overall viewing experience. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {ChatGPT; Combinational network; Generative learning; Movie script; Multi-Stage optimization},
	keywords = {Motion pictures; Automatic Generation; ChatGPT; Combinational network; Generation algorithm; Generative learning; Genetic optimization; Movie script; Multi-stage optimization; Multi-stages; Optimization models; Iterative methods},
	publisher = {University of Buckingham Press},
	issn = {17400716; 14798751},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
