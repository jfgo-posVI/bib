	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84896765785&doi=10.1109%2FDigitalHeritage.2013.6743779&partnerID=40&md5=e2cdbcb0c89de146dbe2677559d14fa5},
	affiliations = {University of California, San Diego, La Jolla, United States; University of California, San Diego, Department of Anthropology, La Jolla, United States},
	abstract = {Archaeology is a discipline that studies time through an understanding of space and objects in that space; archaeology is ultimately, therefore, an intersection where the visualization of space and the visualization of time meet. Archaeology has long utilized visualization as a technique to analyze and disseminate information; however, comprehensive and collaborative analysis and storytelling with this visual data has always been limited by the capacity of the systems, which create and display it. To present the most complete narrative of the past, one must seek the 'big picture' by assembling the disparate pieces of data, which reflect the lives of the humans we study. This paper presents a framework for the visualization of and interaction with rich data collections in high resolution, networked, tiled-display environments, called the MediaCommons Framework. © 2013 IEEE. © 2014 Elsevier B.V., All rights reserved.},
	keywords = {Collaborative analysis; Cultural heritages; Data collection; High resolution; Mixed medias; Visual data; History; Information dissemination; Visualization; Data visualization},
