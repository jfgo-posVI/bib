@ARTICLE{Fu2025,
	author = {Fu, Yu and Bromley, Dennis and Setlur, Vidya},
	title = {DataWeaver: Authoring Data-Driven Narratives through the Integrated Composition of Visualization and Text},
	year = {2025},
	journal = {Computer Graphics Forum},
	volume = {44},
	number = {3},
	pages = {},
	doi = {10.1111/cgf.70098},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005589432&doi=10.1111%2Fcgf.70098&partnerID=40&md5=1acf5c71c639494c0acf55b7b39b8f04},
	affiliations = {Georgia Institute of Technology, Atlanta, United States; Tableau Research, Seattle, United States; Tableau Research, Palo Alto, United States},
	abstract = {Data-driven storytelling has gained prominence in journalism and other data reporting fields. However, the process of creating these stories remains challenging, often requiring the integration of effective visualizations with compelling narratives to form a cohesive, interactive presentation. To help streamline this process, we present an integrated authoring framework and system, DataWeaver, that supports both visualization-to-text and text-to-visualization composition. DataWeaver enables users to create data narratives anchored to data facts derived from “call-out” interactions, i.e., user-initiated highlights of visualization elements that prompt relevant narrative content. In addition to this “vis-to-text” composition, DataWeaver also supports a “text-initiated” approach, generating relevant interactive visualizations from existing narratives. Key findings from an evaluation with 13 participants highlighted the utility and usability of DataWeaver and the effectiveness of its integrated authoring framework. The evaluation also revealed opportunities to enhance the framework by refining filtering mechanisms and visualization recommendations and better support authoring creativity by introducing advanced customization options. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {CCS Concepts; Interactive systems and tools; • Human-centered computing → Visualization systems and tools},
