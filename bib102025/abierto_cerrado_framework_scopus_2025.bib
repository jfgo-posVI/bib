@CONFERENCE{Wang2025431,
	author = {Wang, Bingyuan and Meng, Hengyu and Cao, Rui and Cai, Zeyu and Li, Lanjiong and Ma, Yue and Chen, Qifeng and Wang, Zeyu},
	title = {MagicScroll: Enhancing Immersive Storytelling with Controllable Scroll Image Generation},
	year = {2025},
	pages = {431 - 441},
	doi = {10.1109/VR59515.2025.00067},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002723300&doi=10.1109%2FVR59515.2025.00067&partnerID=40&md5=193e2f267b869f1ed55167f88eb320d7},
	affiliations = {Hong Kong University of Science and Technology, Hong Kong, Hong Kong; Xiamen University Malaysia, Sepang, Malaysia; Hong Kong University of Science and Technology, Hong Kong, Hong Kong},
	abstract = {Scroll images are a unique medium commonly used in virtual reality (VR) providing an immersive visual storytelling experience. Despite rapid advances in diffusion-based image generation, it remains an open research question to generate scroll images suitable for immersive, coherent, and controllable storytelling in VR. This paper proposes a multi-layered, diffusion-based scroll image generation framework with a novel semantic-aware denoising process. We incorporate layout prediction and style control modules to generate coherent scroll images of any aspect ratio. Based on the scroll image generation framework, we use different multi-window strategies to render diverse visual forms such as chains, rings, and forks for VR storytelling. Quantitative and qualitative evaluations demonstrate that our techniques can significantly enhance text-image consistency and visual coherence in scroll image generation, as well as the level of immersion and engagement of VR storytelling. We will release our source code to facilitate better collaborations on immersive storytelling between AI researchers and creative practitioners. https://magicscroll.github.io/ © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {diffusion models; immersive experience; scroll image generation; visual storytelling},
	keywords = {Diffusion model; Image generations; Immersive; Immersive experience; Layered diffusions; Multi-layered; Research questions; Scroll image generation; Semantic-aware; Visual storytellings; Aspect ratio},
	correspondence_address = {Z. Wang; The Hong Kong University of Science and Technology, Guangzhou, China; email: zeyuwang@ust.hk},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798331536459},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Conf. Virtual Real. 3D User Interfaces, VR},
