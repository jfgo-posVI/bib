   issn = {UNKNOWN},
   issue = {UNKNOWN},
   journal = {UNKNOWN},
   keywords = {Complex networks; Computational linguistics; Attention mechanisms; Auxiliary loss.; BERT; Co-attention mechanism; Linguistic knowledge; Neural-networks; Photo album; Teacher-student neural network; Teachers'; Visual storytellings; Semantics},
   month = {10},
