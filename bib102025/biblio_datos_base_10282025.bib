   keywords = {Job analysis; Quality control; Visualization; Breakings; Data driven; Data exploration; Data-driven storytelling; Design Patterns; Interaction; Interview; Narrative device; Task analysis; User study; Data visualization; article; data privacy; human; interview; learning curve; narrative; recall},
