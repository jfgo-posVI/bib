   year = {2021}
}
@article{Shan2022,
   abstract = {Cultural heritage is non-renewable and irreplaceable, which needs to be preserved and passed on. In the digital age, cultural heritage can be brought to life through data storytelling, a communication tool that effectively blends science and technology with humanistic structures, empowering cultural heritage and promoting the transmission and dissemination of culture. The research begins with developing and studying data storytelling in the digital age. The concept and development of data storytelling are reviewed through literature research, and its theoretical basis and three essential elements are analysed: data science, visualisation, and narratology. The design objectives, data framework, and visualisation process of data storytelling in cultural heritage are analysed through desktop research and theoretical studies of the project and literature. Finally, the design strategy of data storytelling in cultural heritage is proposed, conducive to promoting digital humanities research, popularising cultural data information and value dissemination, and telling cultural stories. © 2022 Elsevier B.V., All rights reserved.},
