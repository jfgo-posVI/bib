   issue = {UNKNOWN},
   journal = {UNKNOWN},
   keywords = {Best paths; Creatives; External knowledge; Image sequence; Input image; Iterative generation; Knowledge generations; Learn+; Storylines; Visual storytellings},
   month = {10},
