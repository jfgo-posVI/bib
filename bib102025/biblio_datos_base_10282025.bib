   journal = {UNKNOWN},
   keywords = {Computer vision; Image enhancement; Long short-term memory; Object recognition; Semantics; Contemporary techniques; Image and video captioning; Image sequence; Input image; Input sequence; Objects detection; Semantic attribute; Sequence of images; Storytelling; Visual storytellings; Object detection},
   month = {10},
