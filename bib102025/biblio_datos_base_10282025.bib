   issue = {UNKNOWN},
   journal = {UNKNOWN},
   keywords = {Computer vision; Convolution; Graphic methods; Associative learning; Convolutional networks; Divergent thinkings; Graph convolutional network; Graph-based; Learn+; Learning network; Pointwise mutual information; Visual storytellings; Word-pairs; Learning systems},
   month = {10},
