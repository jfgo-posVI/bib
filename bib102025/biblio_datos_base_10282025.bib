   issn = {0736587X},
   issue = {UNKNOWN},
   journal = {UNKNOWN},
   keywords = {Fairy tales; Image captioning; Learn+; Memory modules; Performance; Random Mappings; Real-world; Simple++; Trade off; Visual storytellings; Economic and social effects},
   month = {10},
   note = {Se mantiene},
   pages = {11053 - 11066},
