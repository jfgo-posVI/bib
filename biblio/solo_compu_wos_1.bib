@article{ WOS:001566070700001,
Author = {Shih, Tsui-Yii},
Title = {Consumer Perspective Scales for Creating a Good Metaverse Environment:
   The Power of Storytelling and Sensory Immersion},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER INTERACTION},
Year = {2025},
Month = {2025 SEP 5},
Abstract = {As immersive technologies gain momentum, exploring how creative
   narratives, sensory immersion, and interaction standards influence
   perceived value and satisfaction in virtual environments is crucial in
   shaping the future of digital experiences. Grounded in the
   Stimulus-Organism-Response (S-O-R) Model, this study examines the
   relationships among storytelling, sensory stimuli, flow experience, and
   overall experience quality in immersive virtual environments (IVEs). In
   this framework, storytelling and sensory cues act as external stimuli
   that impact users' internal states, manifested as flow and enhanced
   experiential quality, which in turn drive positive responses such as
   increased experiential value, heightened re-experience, and stronger
   purchase intentions. An online survey of 502 valid samples provided data
   for statistical analyses, including correlation, regression, and
   structural equation modeling (SEM). The results confirm the research
   framework and consumer perspective measurement scales, suggesting that
   effectively designed sensory and narrative elements substantially
   enhance internal engagement and satisfaction, driving favorable
   behavioral outcomes.},
