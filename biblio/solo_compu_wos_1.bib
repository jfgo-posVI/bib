@article{ WOS:001581702900001,
Author = {Fernandez, Geoffrey Bryan and Gaur, Rashmi},
Title = {Unwriting hegemonic narratives: examining Venba as a decolonial
   intervention in video game spaces},
Journal = {NEW REVIEW OF HYPERMEDIA AND MULTIMEDIA},
Year = {2025},
Month = {2025 SEP 20},
Abstract = {This article analyzes Venba (Visai Games, 2023), a narrative cooking
   video game, as a significant intervention in decolonial game design and
   Indian digital literature. Drawing from decolonial theory and game
   studies, the study introduces the framework of ``unwriting{''} to
   examine how the game challenges hegemonic representations embedded in
   global video game production. By centreing Indian Tamil Hindu diasporic
   experiences, Venba reconfigures food, language, and gendered labour as
   epistemological tools for cultural preservation and intergenerational
   pedagogy. The analysis employs a multimodal methodology that integrates
   close ludonarrative reading, visual semiotics, and paratextual materials
   to explore how Venba resists cultural commodification and linguistic
   imperialism while confronting internal caste and gendered hierarchies.
   Additionally, the article contextualises Venba's production within the
   asymmetries of global game industries, highlighting the structural
   challenges faced by non-Western developers. Ultimately, this study
   argues that Venba exemplifies how video games can function as relational
   archives and affective pedagogies, advancing decolonial praxis and
   expanding the epistemic scope of game studies through culturally
   grounded, regionally specific, and emotionally resonant design
   strategies.},
