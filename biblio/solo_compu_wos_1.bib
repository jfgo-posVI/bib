@article{ WOS:001529628800014,
Author = {Yan, Lili and Zheng, Lei},
Title = {Using Big Data to Tailor Marketing and Improve User Engagement in the
   Animation Industry},
Journal = {JOURNAL OF CASES ON INFORMATION TECHNOLOGY},
Year = {2025},
Volume = {27},
Number = {1},
Abstract = {This paper introduces a novel enhanced Big Data Analytics (BDA)
   algorithm designed to improve user experience in the animation industry.
   By combining data mining and machine learning techniques, including
   K-means clustering, the algorithm analyzes user behavior based on
   demographic factors, particularly age. Using data from a major Chinese
   animation platform, the study identifies age-specific preferences:
   children prefer simpler plots, while teenagers favor complex narratives.
   The algorithm enables precise user segmentation, enhancing targeted
   marketing and significantly improving viewer engagement and
   click-through rates. This research contributes to the field by
   demonstrating how Big Data and machine learning can optimize content
   recommendations and marketing strategies, fostering user loyalty and
   promoting the growth of domestic animation content. The study offers a
   comprehensive framework for future BDA applications in creative
   industries, advancing personalized marketing practices in the animation
   sector.},
