@article{ WOS:000973222100012,
Author = {Wang, ZiXuan},
Title = {Analyzing the applications of big data in network public opinion
   monitoring using FAHP and EDAS methods},
Journal = {SOFT COMPUTING},
Year = {2023},
Month = {2023 APR 20},
Abstract = {Big data technology and algorithms are widely used in every field of
   life due to the rapid development and advancement of information
   technology. Media sites are among those fields that have widely adopted
   big data algorithms and techniques to enhance their utilization and
   accuracy. These approaches also help to efficiently monitor and manage
   network public opinion (NPO). NPO monitoring, also known as initial
   story finding, is described under the subject of detection and
   monitoring of a specific Internet news occurrence. Mostly, it is
   utilized to determine news propagation. Thanks to the rapid changes in
   information technology and the close integration of digital and network
   technology, big data is now an efficient approach for reflecting public
   sentiment and will in the modern generation. Online public opinion is
   having a greater and greater influence on society, and it is becoming
   harder and harder to govern. The important issue in the online world is
   how to establish better management and supervision of the network of
   public sentiment and public perception assessment by precisely grasping
   the development of its dissemination and limiting its detrimental
   influence on public opinion. To advance economic growth and social
   advancement, it is crucial to design a plan for guiding public sentiment
   and promoting the creation of sustainable networks. The rapid usage and
   implementation of big data algorithms in media and public opinion are
   creating issues for developers and scholars. The key aim of the
   presented research is to select a suitable and effective big data
   algorithm for NPO monitoring. To make an effective decision, we first
   cautiously reviewed the previous publications and extracted numerous
   relevant and significant features from them. After this, we select eight
   features and ten candidates from them. For their better evaluation, we
   implement two methods called the fuzzy analytical hierarchy process
   (FAHP) and evaluation based on distance from average solution (EDAS) in
   the proposed article. At first, we determine the goal, criteria, and
   alternatives in the proposed study. Secondly, we implement the FAHP
   approach to examine and assign weight to each selected feature.
   Furthermore, we apply the EDAS framework in order to analyze the
   selected alternatives based on the identified weights of criteria and
   grade them based on their evaluated values. The suggested analysis
   demonstrates that the big data strategy with the best assessment score
   takes first place and is suggested as a solid option. The big data
   strategy with the lowest assessment score, however, comes in last and is
   suggested as the least desirable option. An effective big data approach
   is selected among numerous alternatives. The suggested methods are quite
   beneficial for accurately analyzing the uses of big data in NPO
   monitoring and making decisions. The study concluded that big data tools
   and algorithms are essential for improving NPO monitoring. It is a
   possible strategy for boosting motivation that might have a substantial
   influence on the development and monitoring of opinions. The assessment
   that is offered could aid analysts in making better decisions so that
   they can choose an appropriate alternative among several available
   options.},
