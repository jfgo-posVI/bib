@article{ WOS:000963810700001,
Author = {Brossier, Mathis and Skanberg, Robin and Besancon, Lonni and Linares,
   Mathieu and Isenberg, Tobias and Ynnerman, Anders and Bock, Alexander},
Title = {Moliverse: Contextually embedding the microcosm into the universe},
