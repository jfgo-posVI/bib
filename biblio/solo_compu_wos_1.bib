@article{ WOS:001464818700001,
Author = {Gupta, Jaya and Rai, Deepak and Singh, Prabhishek},
Title = {GenSumNet: A genre-specific and context-aware video summarization
   framework with adaptive thresholding and hybrid temporal modeling},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {279},
Month = {JUN 15},
Abstract = {GenSumNet is a supervised, genre-aware video summarization framework
   that addresses genre-specific challenges in video analysis. It
   integrates subshot-level complexity scoring, shot analysis, and temporal
   complexity graphs to capture genre-specific patterns while preserving
   narrative coherence. A dual-stage adaptive thresholding mechanism
   ensures genre-aware frame selection, filtering redundancies while
   retaining informative frames. Adaptive model selection employs
   DenseNet-161 for complex frames and MobileNetV3 for non-complex frames.
   Hierarchical temporal modeling fuses Self-Attention Transformers and
   Bi-LSTMs to capture both short-and long-term dependencies. A
   knapsack-based diversity-aware optimization method enhances summary
   diversity and conciseness. Evaluated on SumMe, TVSum, CATARACTS,
   JIGSAWS, and YouTube datasets, GenSumNet achieves a 21.38\% average
   F1-score improvement over state-of-the-art supervised and unsupervised
   methods. Its effectiveness is further validated through diversity,
   coverage, and temporal coherence assessments, supported by an ablation
   study and qualitative analysis. Its genre-specific, context-aware, and
   complexity-sensitive approach ensures robustness across general and
   medical domains.},
