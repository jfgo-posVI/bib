@article{ WOS:001414439000001,
Author = {Thumbadoo, Romola V. and Thumbadoo, Zenuella S. and Taylor, D. R. Fraser},
Title = {Children's cognitive story mapping: a complex South Africa/Canada
   transdisciplinary collaboration},
Journal = {INTERNATIONAL JOURNAL OF CARTOGRAPHY},
Year = {2025},
Month = {2025 FEB 5},
Abstract = {This innovative transdisciplinary children's cognitive story mapping
   collaboration was initiated in 2022 by Circle of All Nations (CAN),
   Geomatics and Cartographic Research Centre (GCRC) Carleton University,
   (in Canada), National Association of Child Care Workers (NACCW) and
   Durban University of Technology (DUT) (in South Africa). It integrates
   approaches from arts and humanities, social services and cartography in
   child and youth care work by engaging social service sector workers and
   researchers in art story map creation with children and youth. The joint
   engagement and research in the compilation and presentation of the data,
   findings and knowledge is leading to new dimensions in participatory
   mapping where children initiate the map creation process with workers.
   The children's map visualizations of social and environmental realities,
   concerns and needs have led to a prioritization of issues for practice,
   program and policy development, including in child protection case
   management. Researchers complement the work with national and provincial
   digital maps that permit analysis and focussed interventions. This
   article introduces the term Cognitive Story Maps; it is a preliminary
   exploration of theoretical frameworks, including Indigenous, that
   support collaborative bridge building between distinct domains of
   creative visualization, methodological practice and cartographic
   representation to generate innovations in knowledge creation and
   research.
   Cette collaboration transdisciplinaire innovante des cartes narratives
   cognitives des enfants a \& eacute;t \& eacute; lanc \& eacute;e en 2022
   par le cercle des nations (CAN), le centre de recherche en g \&
   eacute;omatique et cartographie de l'universit \& eacute; de Carleton
   (GCRC) au Canada et l'association nationale des travailleurs dans le
   secteur des soins des enfants (NACCW) et l'universit \& eacute;
   technologique de Durban en Afrique du Sud. Cette collaboration int \&
   egrave;gre des approches artistiques et des sciences humaines, des
   services sociaux et de la cartographie dans le travail de soin aux
   jeunes et aux enfants, en engageant des travailleurs du secteur des
   services sociaux et des chercheurs en cr \& eacute;ation de cartes
   narratives artistiques avec des enfants et des jeunes. L'engagement et
   la recherche dans la compilation et la pr \& eacute;sentation des donn
   \& eacute;es, des r \& eacute;sultats et des connaissances conduisent \&
   agrave; de nouvelles dimensions dans la cartographie participative o \&
   ugrave; les enfants initient le processus de cr \& eacute;ation
   cartographique avec les travailleurs. Les visualisations cartographiques
   faites par les enfants des r \& eacute;alit \& eacute;s, des pr \&
   eacute;occupations et des besoins sociaux et environnementaux ont
   conduit \& agrave; une priorisation des enjeux pour l'\&
   eacute;laboration des pratiques, des programmes et des politiques dont
   la gestion des dossiers de protection de l'enfance. Les chercheurs ont
   compl \& eacute;t \& eacute; leur travail avec des cartes num \&
   eacute;riques nationales et provinciales qui permettent des analyses et
   des interventions cibl \& eacute;es. Ce papier introduit la notion de
   carte narrative cognitive, il s'agit d'une premi \& egrave;re
   exploration des cadres th \& eacute;oriques, y compris autochtones, qui
   permettent la cr \& eacute;ation de ponts collaboratifs entre les diff
   \& eacute;rents domaines de la visualisation cr \& eacute;ative, de la
   pratique m \& eacute;thodologique et de la repr \& eacute;sentation
   cartographique pour produire des avanc \& eacute;es dans la cr \&
   eacute;ation de connaissance et dans la recherche.},
