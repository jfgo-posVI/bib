@article{ WOS:000685882800001,
Author = {Min, Kyungbok and Dang, Minh and Moon, Hyeonjoon},
Title = {Deep Learning-Based Short Story Generation for an Image Using the
   Encoder-Decoder Structure},
Journal = {IEEE ACCESS},
