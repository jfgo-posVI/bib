@article{ WOS:001256367400001,
Author = {Allgaier, Johannes and Pryss, Ruediger},
Title = {Cross-Validation Visualized: A Narrative Guide to Advanced Methods},
Journal = {MACHINE LEARNING AND KNOWLEDGE EXTRACTION},
