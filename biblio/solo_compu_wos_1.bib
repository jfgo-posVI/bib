@article{ WOS:001139606800001,
Author = {Himeur, Yassine and Sayed, Aya Nabil and Alsalemi, Abdullah and
   Bensaali, Faycal and Amira, Abbes},
Title = {Edge AI for Internet of Energy: Challenges and perspectives},
