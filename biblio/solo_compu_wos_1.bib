@article{ WOS:001509890400001,
Author = {Gurung, Mayor Inna and Agarwal, Nitin and Bhuiyan, Md Monoarul Islam and
   Poudel, Diwash},
Title = {Symbolic signals on Instagram: how visual media shapes engagement,
   emotion, trust, and diffusion},
Journal = {SOCIAL NETWORK ANALYSIS AND MINING},
Year = {2025},
Volume = {15},
Number = {1},
Month = {JUN 16},
Abstract = {Throughout history, visual symbols have served as powerful tools for
   communication, uniting communities, shaping narratives, and driving
   social movements. From traditional media such as pamphlets and murals to
   contemporary public art, these symbols carry profound social, cultural,
   and political (SCP) significance, fostering identity, unity, and shared
   values through the framework of symbolic interaction theory. In the
   digital era, platforms like Instagram have revolutionized the creation,
   dissemination, and interpretation of visual symbols, enabling rapid
   sharing and offering early indicators of campaign effectiveness. This
   study examines the role of symbolic imagery in shaping user engagement,
   creating emotional responses, establishing trust, and affecting
   diffusion dynamics, focusing on Taiwan's recent election-related
   disinformation debunking campaign. Analyzing 3,097 Instagram posts
   collected between January 13 and January 27, 2024, we employed advanced
   computational models, including GPT-4o and Gemini Pro Vision, to
   identify SCP symbols embedded in the content. Our findings reveal that
   posts featuring symbolic imagery significantly outperform those without
   such elements in generating user interactions, evoking emotional
   resonance, enhancing perceived trust, and achieving faster diffusion. In
   particular, posts that incorporate cultural symbols demonstrated the
   highest impact, strongest resonance, and fastest diffusion among the
   audience. These insights offer valuable, data-driven strategies for
   policymakers and content creators engaged in strategic communication to
   leverage visual symbols effectively in combating misinformation and
   fostering meaningful public discourse in today's hyper-connected digital
   landscape.},
