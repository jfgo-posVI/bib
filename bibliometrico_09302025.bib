    affiliation = "Ohno, Yukiko Keio University, Tokyo, Japan; Aomori, Tohru Takasaki University of Health and Welfare, Faculty of Pharmacy, Takasaki, Japan; Nishiyama, Tomohiro Nara Institute of Science and Technology, Ikoma, Japan; Kato, Riri Keio University, Faculty of Pharmacy, Tokyo, Japan; Fujiki, Reina Keio University Hospital, Department of Pharmacy, Tokyo, Japan; Ishikawa, Haruki Keio University School of Medicine, Tokyo, Japan",
