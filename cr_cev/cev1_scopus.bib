@ARTICLE{Saeed2024,
	author = {Saeed, Khawaja Asjad and Wu, Dezhi and Xu, Jingjun (David)},
	title = {Effect of Designer- versus User-driven Network-monitoring Dashboard Design on User Flow Experience and Performance: The Role of Augmented Virtuality},
	year = {2024},
	journal = {Information and Management},
	volume = {61},
	number = {3},
