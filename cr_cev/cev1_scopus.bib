@ARTICLE{Jones2003184,
	author = {Jones, Sarah J. and Lyons, Ronan A.},
	title = {Routine narrative analysis as a screening tool to improve data quality},
	year = {2003},
	journal = {Injury Prevention},
	volume = {9},
	number = {2},
	pages = {184 - 186},
	doi = {10.1136/ip.9.2.184},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0141783755&doi=10.1136%2Fip.9.2.184&partnerID=40&md5=2b5159fe143a72eeddfeb31452402535},
	affiliations = {Cardiff University, Department of Epidemiology, Statistics and Public Health, Cardiff, United Kingdom},
	abstract = {Aim: To determine whether narrative information in emergency department surveillance systems can be systematically interrogated to improve our understanding of the causes of injury. Methods: Screening algorithms for location, intent, and activity were developed from structured analysis of narrative data from 98 999 records. The algorithms were then tested on a 50 000 record database containing entries in both of the two narrative fields. A proxy gold standard was defined as the total extract using both code and narrative. Sensitivity and specificity of the emergency department coding and narrative algorithms was calculated. Results: The proportion of records carrying an informative emergency department code was higher in records containing narrative - the percentage of causes coded "not know" dropped by 28.3%. The sensitivity of coded data varied from 42% to 98 % and from 33% to 99% for narrative data. Narrative analysis increased the percentage of home injuries identified by 19%, assaults by 26%, and rugby injuries by 137%. Conclusions: Using a small amount of narrative is a practical and effective means of developing more informative injury causation data in an emergency department based surveillance system. It allows for internal validation of the codes and for the identification of emerging hazards without adding more "tick boxes" or further burdening data entry clerks. © 2011 Elsevier B.V., All rights reserved.},
