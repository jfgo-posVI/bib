@article{ WOS:000706330100078,
Author = {Dasu, Keshav and Ma, Kwan-Liu and Ma, Joyce and Frazier, Jennifer},
Title = {Sea of Genes: A Reflection on Visualising Metagenomic Data for Museums},
Journal = {IEEE TRANSACTIONS ON VISUALIZATION AND COMPUTER GRAPHICS},
Year = {2021},
Volume = {27},
Number = {2},
Pages = {935-945},
Month = {FEB},
Abstract = {We examine the process of designing an exhibit to communicate scientific
   findings from a complex dataset and unfamiliar domain to the public in a
   science museum. Our exhibit sought to communicate new lessons based on
   scientific findings from the domain of metagenomics. This multi-user
   exhibit had three goals: (1) to inform the public about microbial
   communities and their daily cycles; (2) to link microbes' activity to
   the concept of gene expression; (3) and to highlight scientists' use of
   gene expression data to understand the role of microbes. To address
   these three goals, we derived visualization designs with three
   corresponding stories, each corresponding to a goal. We present three
   successive rounds of design and evaluation of our attempts to convey
   these goals. We could successfully present one story but had limited
   success with our second and third goals. This work presents a detailed
   account of an attempt to explain tightly coupled relationships through
   storytelling and animation in a multi-user, informal learning
   environment to a public with varying prior knowledge on the domain and
   identify lessons for future design.},
Publisher = {IEEE COMPUTER SOC},
Address = {10662 LOS VAQUEROS CIRCLE, PO BOX 3014, LOS ALAMITOS, CA 90720-1314 USA},
Type = {Article},
Language = {English},
Affiliation = {Dasu, K (Corresponding Author), Univ Calif Davis, Davis, CA 95616 USA.
   Dasu, Keshav; Ma, Kwan-Liu, Univ Calif Davis, Davis, CA 95616 USA.
   Ma, Joyce; Frazier, Jennifer, Exploratorium, San Francisco, CA USA.},
DOI = {10.1109/TVCG.2020.3030412},
ISSN = {1077-2626},
EISSN = {1941-0506},
Keywords = {Narrative visualization; storytelling; animation; evaluation; user
   studies; informal learning environments},
Keywords-Plus = {NARRATIVE VISUALIZATION; ANIMATIONS; ANNOTATION; TREE},
Research-Areas = {Computer Science},
Web-of-Science-Categories  = {Computer Science, Software Engineering},
Author-Email = {kdasu@ucdavis.edu
   ma@ucdavis.edu
   jma@exploratorium.edu
   jfrazier@exploratorium.edu},
Affiliations = {University of California System; University of California Davis},
ResearcherID-Numbers = {MA, Lei/I-4597-2014},
Funding-Acknowledgement = {U.S. National Science Foundation {[}DRL-1323214, DRL-1322828,
   IIS-1528203]; Gordon and Betty Moore Foundation},
Funding-Text = {The authors wish to thank Elisha Wood-Charlson and Ed DeLong for sharing
   the SCOPE dataset and for their time and expertise. We would also like
   to thank Eric Rodenbeck, Nicolette Hayes, and Andrew Wong of Stamen
   Design for collaborating on the design and development of the
