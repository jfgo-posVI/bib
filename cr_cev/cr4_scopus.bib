	year = {2023},
	journal = {OTJR Occupation, Participation and Health},
	volume = {43},
	number = {1},
	pages = {98 - 108},
	doi = {10.1177/15394492221078315},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85125425254&doi=10.1177%2F15394492221078315&partnerID=40&md5=395eb822e842e9341fca3d67555013bf},
	affiliations = {University of Waterloo, Waterloo, Canada; Western University, London, Canada},
	abstract = {Age-related vision loss (ARVL) has been shown to interfere with older adults’ occupational engagement. The primary purpose was to examine the role social networks play in facilitating/constraining engagement in desired occupations for older adults with ARVL. This study adopted a constructivist narrative methodology. Five older adults, ≥ 60 years of age with ARVL, participated in three virtual interviews, which were coded using thematic analysis. Three overarching themes were identified: (a) Diverse Social Networks Fulfill Different Occupational and Psychosocial Needs, (b) Retaining a Sense of Independence through Seeking Reciprocity in Social Relationships, and (c) Community Mobility and Technology Support as Essential for Preserving Social Relationships. Findings broaden understandings of how informal/formal social networks are involved in shaping visually-impaired older adults’ adaptation to ARVL and related occupational changes. Findings may help improve the quality and delivery of low-vision rehabilitation services to optimize their contribution to occupational engagement. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {occupational science; older adults; rehabilitation; social participation; visual perception},
	keywords = {adult; age related macular degeneration; aged; Article; controlled study; coronavirus disease 2019; diabetic retinopathy; Diverse Social Networks Fulfill Different Occupational and Psychosocial Needs; emotionality; feed back interview; female; glaucoma; help seeking behavior; human; interview; low vision; macular degeneration; male; narrative; occupation; occupational engagement; occupational science; rehabilitation medicine; semi structured interview; Severe acute respiratory syndrome coronavirus 2; social adaptation; social interaction; social network; social participation; social support; storytelling; thematic analysis; visual impairment; human relation; psychology; verbal communication; visual disorder; Aged; Humans; Interpersonal Relations; Narration; Social Networking; Vision Disorders},
