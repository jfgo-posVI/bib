}

@ARTICLE{Younas20221124,
	author = {Younas, Ahtisham and Shahzad, Sharoon and Inayat, Shahzad},
	title = {Data Analysis and Presentation in Integrative Reviews: A Narrative Review},
	year = {2022},
	journal = {Western Journal of Nursing Research},
	volume = {44},
	number = {12},
	pages = {1124 - 1133},
	doi = {10.1177/01939459211030344},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85110095849&doi=10.1177%2F01939459211030344&partnerID=40&md5=8f993cce11d77e2eaa8831cdfb31603b},
	affiliations = {Memorial University of Newfoundland, Faculty of Nursing, St John's, Canada; Swat College of Nursing, Mingora, Pakistan; Islamabad Nursing College, Islamabad, Pakistan; Isra University, College of Nursing, Hyderabad, Pakistan},
	abstract = {Integrative reviews are invaluable for synthesizing literature to guide practice. This review examined the nature and range of data analysis approaches and the methods used for data presentation in integrative reviews. We reviewed 151 integrative reviews published from January to December 2019 in nursing journals listed in Journal Citation Report 2020. Summary tables were used for data extraction and researcher-developed questions-based process for synthesis. Data analysis and synthesis methods were categorized as non-specific, inductive, deductive, and framework-based. Majority of reviews did not explicitly delineate data analysis and synthesis methods (n = 67) or used inductive methods (n = 55). Limited reviews used deductive (n = 13) and framework-based methods (n = 13). Most of the reviews used narrative descriptions for presentations of findings, but some reviews also used innovative tables, concept maps, frameworks, and word clouds to enhance data presentation. The findings provide a comprehensive overview of the diversity of methods for data analysis and presentation in integrative reviews. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Data synthesis; Integrative reviews; Literature review; Research methodology; Research methods; Synthesis},
	keywords = {article; data analysis; data extraction; data synthesis; human; major clinical study; narrative; nursing; information processing; personnel; publication; Data Analysis; Data Collection; Humans; Publications; Research Personnel},
	publisher = {SAGE Publications Inc.},
	issn = {01939459; 15528456},
	pmid = {34250869},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 18}
}

