@ARTICLE{Zhou202520417,
	author = {Zhou, Di and Li, Taohui and Barakova, Emilia Ivanova and Chen, Chunxiao and Zhang, Jun},
	title = {Enhancing positive emotions and creativity in visual storytelling: the effect of multimedia transformation of drawings},
	year = {2025},
	journal = {Education and Information Technologies},
	volume = {30},
	number = {14},
	pages = {20417 - 20443},
	doi = {10.1007/s10639-025-13534-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003398274&doi=10.1007%2Fs10639-025-13534-4&partnerID=40&md5=eb1603b0f186b8d4ad06786d3fcd0be0},
	affiliations = {Nanjing University of Science and Technology, School of Design Art and Media, Nanjing, China; Technische Universiteit Eindhoven, Department of Industrial Design, Eindhoven, Netherlands; Jiangnan University, School of Artificial Intelligence and Computer Science, Wuxi, China},
	abstract = {Visual storytelling is a widely practiced educational activity that encourages children’s verbal and figural creative expression through both narrative and drawing. This study investigated how transforming children’s drawings into multimedia formats—by adding sound effects, animated presentation, or a combination of both—impacted children’s affective reaction and creativity in storytelling. An interactive prototype was developed to apply multimedia transformations to children’s drawings when they experienced creative blocks. A mixed-methods approach was employed, involving 80 children aged 8 to 10 years, who were randomly assigned to four groups: a control group and three intervention groups subjected to sound effects, animated presentations, and a combination of both. Emotional and creative outcomes were assessed across these groups. Quantitative analyses showed that the groups subjected to the multimedia transformations exhibited significantly stronger positive emotions and creativity compared to the control group. Qualitative findings further revealed that children in the multimedia transformation groups experienced greater immersion due to the sound effects, which encouraged more detailed story elaboration, while the animated presentations facilitated the exploration of cause-and-effect relationships, inspiring more expansive storylines. The combination of the sound effects and the animated presentations was observed to provide the most comprehensive support, enhancing positive emotions, boosting independent creativity, and helping children overcome creative blocks in visual storytelling without introducing new content from external sources. These findings inform the design of storytelling-assisted systems and broaden understanding of how multimedia supports creativity and independent problem-solving through emotional enhancement. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Animation; Creativity; Emotion; Multimedia; Sound effects; Visual storytelling},
	publisher = {Springer},
	issn = {13602357},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

