	author = {Cemillán Casis, Luis and Jiménez Alcarria, Francisco},
	title = {Modular narratives and visual digital culture in contemporary cinema. The case of Open Windows (Nacho Vigalondo, 2014); Narrativas modulares y cultura visual digital en el cine contemporáneo. El caso de Open Windows (Nacho Vigalondo, 2014)},
