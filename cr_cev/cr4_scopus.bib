@ARTICLE{Crettez2023480,
	author = {Crettez, Bertrand and Deloche, Régis and Tallec, Ronan},
	title = {An analytical narrative of the Day of Dupes},
	year = {2023},
	journal = {Rationality and Society},
	volume = {35},
	number = {4},
	pages = {480 - 501},
	doi = {10.1177/10434631231194142},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168442113&doi=10.1177%2F10434631231194142&partnerID=40&md5=db2bb0b8c375e02da70dd6bd145f36e1},
	affiliations = {Université Paris 2 Panthéon-Assas, Paris, France; Université Paris Cité, Paris, France},
	abstract = {On November, 11th, 1630, Queen Marie de’ Medici demanded, in vain, that her son, King Louis XIII, dismiss Richelieu as Principal Minister. Historians agree that this crisis known as the Journée des Dupes (the Day of the Dupes) was the true foundation stone of French “absolutism”, but they disagree about whether the decision made by the Queen was rational. We analyze the historical setting of the crisis from a game theory viewpoint where the King and the Queen are two players. We consider two assumptions regarding the King and the Queen’s cognitive skills. On the one hand, we assume that both the King and the Queen are perfectly rational. On the other hand, we assume that they both have limited cognitive skills (that is, they are level-k players). In this last case we propose a definition of naivety and we provide necessary and sufficient conditions for the Queen to be naive. We then study the Nash equilibrium when both the King and the Queen are perfectly rational as well as the behavioral theoretical solution of the game when they have limited cognitive skills. We rely on this study to propose an analytical narrative of the Journées des Dupes. We conclude that what we know of the historical facts does not allow us to reject the assumption that the Queen was perfectly rational, or, if she was not, that she had not been naive. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Absolutism; analytic narrative; behavioral game theory; day of dupes; level-k rationality},
