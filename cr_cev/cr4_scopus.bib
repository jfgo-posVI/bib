@ARTICLE{Cohn2024,
	author = {Cohn, Neil and van Middelaar, Lincy and Foulsham, Tom and Schilperoord, Joost},
	title = {Anaphoric distance dependencies in visual narrative structure and processing},
	year = {2024},
	journal = {Cognitive Psychology},
	volume = {149},
	pages = {},
	doi = {10.1016/j.cogpsych.2024.101639},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184027837&doi=10.1016%2Fj.cogpsych.2024.101639&partnerID=40&md5=bea2d0427f2903926c7888bd49acb365},
	affiliations = {Tilburg School of Humanities and Digital Sciences, Department of Communication and Cognition, Tilburg, Netherlands; University of Essex, Department of Psychology, Colchester, United Kingdom},
	abstract = {Linguistic syntax has often been claimed as uniquely complex due to features like anaphoric relations and distance dependencies. However, visual narratives of sequential images, like those in comics, have been argued to use sequencing mechanisms analogous to those in language. These narrative structures include “refiner” panels that “zoom in” on the contents of another panel. Similar to anaphora in language, refiners indexically connect inexplicit referential information in one unit (refiner, pronoun) to a more informative “antecedent” elsewhere in the discourse. Also like in language, refiners can follow their antecedents (anaphoric) or precede them (cataphoric), along with having either proximal or distant connections. We here explore the constraints on visual narrative refiners created by modulating these features of order and distance. Experiment 1 examined participants’ preferences for where refiners are placed in a sequence using a force-choice test, which revealed that refiners are preferred to follow their antecedents and have proximal distances from them. Experiment 2 then showed that distance dependencies lead to slower self-paced viewing times. Finally, measurements of event-related brain potentials (ERPs) in Experiment 3 revealed that these patterns evoke similar brain responses as referential dependencies in language (i.e., N400, LAN, Nref). Across all three studies, the constraints and (neuro)cognitive responses to refiners parallel those shown to anaphora in language, suggesting domain-general constraints on the sequencing of referential dependencies. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Anaphora; Distance dependencies; ERPs; Narrative; Syntax; Visual language},
	keywords = {brain; electroencephalography; evoked response; female; human; language; linguistics; male; physiology; Brain; Electroencephalography; Evoked Potentials; Female; Humans; Language; Linguistics; Male},
