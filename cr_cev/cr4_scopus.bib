@ARTICLE{Kennedy-Hendricks2022,
	author = {Kennedy-Hendricks, Alene and McGinty, Emma Elizabeth and Summers, Amber C. and Krenn, Susan and Fingerhood, Michael Ira and Barry, Colleen L.},
	title = {Effect of Exposure to Visual Campaigns and Narrative Vignettes on Addiction Stigma among Health Care Professionals: A Randomized Clinical Trial},
	year = {2022},
	journal = {JAMA Network Open},
	volume = {5},
	number = {2},
	pages = {},
	doi = {10.1001/jamanetworkopen.2021.46971},
