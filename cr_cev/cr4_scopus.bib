@ARTICLE{Schubert2022419,
	author = {Schubert, Stefan and Ravizza, Eleonora Natalia},
	title = {‘They Don’t Make Anything Like They Used To’: Visual, Narrative, and Ideological Nostalgia for the West(ern) in Westworld (2016)},
	year = {2022},
