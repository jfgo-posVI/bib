	title = {Visualizing popular Movies’ narrative structures using a Machine learning approach},
	year = {2025},
	journal = {Entertainment Computing},
	volume = {55},
	pages = {},
	doi = {10.1016/j.entcom.2025.101008},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012599989&doi=10.1016%2Fj.entcom.2025.101008&partnerID=40&md5=a3257d7883702dc9b2aceb4de63510fa},
	affiliations = {Chulalongkorn University, Technopreneurship and Innovation Management Program, Bangkok, Thailand; Chulalongkorn University, Faculty of Communication Arts, Bangkok, Thailand; Chulalongkorn University, Faculty of Engineering, Bangkok, Thailand},
	abstract = {This study introduced a machine learning approach to analyze the narrative structures of 140 popular Thai movies released between 2006 and 2022. By automating the extraction of chronological mean shot durations and applying time-series cluster analysis, five distinct narrative structure clusters were identified. Two clusters followed the conventional three-act and four-act structures, two reversed the conventional patterns, and one exhibited a wave-like roller-coaster progression. Chi-square post-hoc analysis revealed that drama films favored both reversed structures. Horror films aligned well with the conventional three-act structure, and action films showed a positive association with the conventional four-act structure. The use of machine learning enabled scalable analysis across large datasets, with time-series cluster analysis effectively uncovering narrative patterns not easily detected through traditional qualitative film study methods. The results offered practical insights for aspiring filmmakers, who can reference the identified narrative structures as visual guides for aligning their movies with successful storytelling patterns. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Machine Learning in Film Studies; Movie Cluster Analysis; Movie Narrative Structure Visualization; Shot Duration Analysis; Thai Cinema Narrative Structure},
	keywords = {Large datasets; Learning systems; Motion pictures; Time series; Time series analysis; X ray films; Film study; Machine learning in film study; Machine-learning; Movie cluster analyze; Movie narrative structure visualization; Narrative structures; Shot duration analyze; Structure visualizations; Thai cinema narrative structure; Cluster analysis},
