@article{ WOS:001583493400001,
Author = {Heinonen, Pilvi and Roiha, Anssi},
Title = {Exploring the trajectory of pre-service language teachers' perceptions
   of teaching and learning: visualisations, metaphors and reflective texts
   as anchors for narrative of change},
Journal = {LANGUAGE LEARNING JOURNAL},
Year = {2025},
Month = {2025 SEP 25},
Abstract = {This longitudinal study examines pre-service language teachers'
   perceptions of learning and teaching and how they change during their
   pedagogical studies. The initial data collected at the beginning of the
   pedagogical studies consist of visualisations of ideal learning
   situations and metaphors related to teaching produced by the
   participants (N = 63). The second data collection took place at the end
   of the pedagogical studies when the participants returned to reflect on
   their initial outputs in writing. In this study, we are interested in
   the kind of narrative of change the participants produce in their
   reflective texts and what kind of objects of change and change agents
   they highlight in relation to their pedagogical perceptions. The data
   have been analysed using thematic content analysis, inspired by a
   dialogical approach to textual analysis. The results show that changes
   in perceptions are typically described through consensus talk and
   supplementary/clarification talk. The objects of change focus on
   learner-centred orientation, concrete pedagogical knowledge and skills
   and on the negotiation between ideal and practice. Our analysis
   indicates that visualisations and metaphors and their written
   reflections produce nuanced narrative of change, and that the initial
   outputs often serve as a concrete reference point to illustrate the
   changes in pedagogical perceptions.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
