@article{ WOS:001282209100007,
Author = {Casis, Luis Cemillan and Alcarria, Francisco Jimenez},
Title = {Modular narratives and visual digital culture in contemporary cinema.
   The case of Open Windows (Nacho Vigalondo, 2014)},
Journal = {DOXA COMUNICACION},
Year = {2024},
Number = {39},
Pages = {147-164},
Month = {JUL-DEC},
Abstract = {In the present day, digital visual and convergence culture permeate the
   modes of production, circulation, and consumption of audiovisual
   representations, following the postulates of authors such as A. Darley
   or H. Jenkins. In this context, A. Cameron defines modular narratives as
   those in which classical narrative causality is replaced by a database
   aesthetic, dividing the narrative into discrete elements subject
   manipulations of order, frequency, and duration. Focusing on case of
   Open Windows (Nacho Vigalondo, 2014), this study aims explore the
   imprints of digital visual culture on contemporary Spanish cinema
   incorporating modular narratives. The methodology employs an analysis
   model adapted to this narrative and aesthetic specificity within the
   framework of Computational Media Aesthetics. The film's mechanisms of
   representation are scrutinized through a multi-screen interface, where
   simultaneous events are juxtaposed within the same visual field,
   alongside an examination of the significance bestowed upon the software
   when utilized as a narrative scaffold. Finally, discussion encompasses
   the necessity of applying such models to analysis of audiovisual content
   associated with digital visual culture, well as their potential utility
   for future research.},
Publisher = {UNIV SAN PABLO, FAC HUMANIDADES \& CIENCIAS COMUNICACION},
Address = {PASEO DE JUAN XXIII 6, BOADILLA DEL MONTE, 28040, SPAIN},
