@article{ WOS:000946380900006,
Author = {Gonzalez, Alejandro Barbosa and Idarraga, Eliana Andrea Celeita and
   Pineda, Christian Camilo Useche},
Title = {hijos discapacidad Narratives about the experience of care in parents of
   children with visual impairment},
Journal = {QUADERNS DE PSICOLOGIA},
Year = {2023},
Volume = {25},
Number = {1},
Abstract = {The impact generated by childhood visual impairment is evident in the
   relationships estab-lished by the child with his environment. The
   research objective was to describe the narra-tives about the experience
   of care in parents of children with visual impairment to generate
   reflections on the associated psychosocial factors and the
   rehabilitation process. For the above, a qualitative methodology of
   narrative design was implemented. As a technique to col-lect the
   information, the in-depth interview was obtained. The participants are
   parents of visually impaired children. The findings show confusion
   associated with the diagnosis, parental overprotection, modifications in
   the parents' life project after the child's diagnosis, conflicts in the
   parental couple, and situations of social exclusion that children face.
   It is concluded that it is important to reflect on the implementation of
   new alternatives to support parents in the process of adaptation to
   diagnosis and rehabilitation.},
