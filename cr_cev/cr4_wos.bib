@article{ WOS:001547399300001,
Author = {Lertpreechapakdee, Nuttanai and Taiphapoon, Tatri and Sinthupinyo,
   Sukree},
Title = {Visualizing popular Movies' narrative structures using a Machine
   learning approach},
Journal = {ENTERTAINMENT COMPUTING},
Year = {2025},
Volume = {55},
Month = {SEP},
Abstract = {This study introduced a machine learning approach to analyze the
   narrative structures of 140 popular Thai movies released between 2006
   and 2022. By automating the extraction of chronological mean shot
   durations and applying time-series cluster analysis, five distinct
   narrative structure clusters were identified. Two clusters followed the
   conventional three-act and four-act structures, two reversed the
   conventional patterns, and one exhibited a wave-like roller-coaster
   progression. Chi-square post-hoc analysis revealed that drama films
   favored both reversed structures. Horror films aligned well with the
   conventional three-act structure, and action films showed a positive
   association with the conventional four-act structure. The use of machine
   learning enabled scalable analysis across large datasets, with
   time-series cluster analysis effectively uncovering narrative patterns
   not easily detected through traditional qualitative film study methods.
   The results offered practical insights for aspiring filmmakers, who can
   reference the identified narrative structures as visual guides for
   aligning their movies with successful storytelling patterns.},
