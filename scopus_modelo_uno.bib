@ARTICLE{Matei2021312,
	author = {Matei, Sorin Adam and Hunter, Lucas},
	title = {Data storytelling is not storytelling with data: A framework for storytelling in science communication and data journalism},
	year = {2021},
	journal = {Information Society},
	volume = {37},
	number = {5},
	pages = {312 - 322},
	doi = {10.1080/01972243.2021.1951415},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112636300&doi=10.1080%2F01972243.2021.1951415&partnerID=40&md5=45df54a7315ba059c00b152c7fc4d2ba},
	affiliations = {Purdue University, West Lafayette, United States},
	abstract = {Storytelling teaches. All good storytelling is good teaching. Storytelling is a form of teaching and learning because it asks the readers or listeners to replace well-established explanations that are considered facts with new, unexpected ones. We always learn new things when listening to good stories. Good stories do so by violating expectations and surprising the listener or the reader. Surprise breeds suspense, which generates engagement, which is a catalyst for learning–even truer for scientific and data-driven stories. In this paper we show how understanding the nature of good stories by focusing on the novelty they introduce and assumption they violate helps us to do effective scientific work and tell excellent data-based stories. We start by providing definitions of “story,” “storytelling,” and “good stories.” We then outline a methodology for building stories and provide an illustrative example of an effective data-based story from the history of medicine. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Data story; data storytelling; expectation violation; learning; science communication; storytelling; teaching},
