	pages = {645 - 659},
	doi = {10.1007/s12650-025-01051-y},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219207517&doi=10.1007%2Fs12650-025-01051-y&partnerID=40&md5=555962c6d588b15647868d0fa8c3fa40},
	affiliations = {University of Technology Sydney, Sydney, Australia; Commonwealth Scientific and Industrial Research Organisation, Canberra, Australia; RMIT University, School of Computer Science and Technology, Melbourne, Australia; Sichuan University of Science & Engineering, Department of Computer Science and Engineering, Zigong, China; Peking University, School of Intelligence Science and Technology, Beijing, China; University of Technology Sydney, Sydney, Australia},
	abstract = {Narrative visualization integrates data visualization and narrative techniques to convey a compelling story. Narrative visualization is notoriously difficult to evaluate. One solution is heuristic evaluation, using a domain-specific set of heuristics. This paper validates a set of heuristics proposed specifically for evaluating narrative visualization. We conducted studies with experienced narrative visualization practitioners in both summative and formative settings. We found that the set of heuristics showed promise in a summative setting, where similar responses evidenced that the set of heuristics could provide reliable evaluation metrics. Furthermore, in a formative setting, implementing the set of heuristics was reported to be useful in the design process; however, due to their limited focus, we recommend that it be implemented in conjunction with other evaluation guidelines. © 2025 Elsevier B.V., All rights reserved.},
