	title = {Unpacking Micro Data Videos: Key Elements and Design Practices in Minute-Long Data Videos for Mobile Usage},
	year = {2025},
	journal = {Proceedings of the ACM on Human-Computer Interaction},
	volume = {9},
	number = {5},
	pages = {},
	doi = {10.1145/3743722},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015408965&doi=10.1145%2F3743722&partnerID=40&md5=ff5e95a6aede6e14859f52beb302d2e4},
	affiliations = {University of British Columbia Okanagan, Department of Computer Science, Kelowna, Canada; University of British Columbia Okanagan, Kelowna, Canada; The University of British Columbia, Vancouver, Canada; The University of British Columbia, Vancouver, Canada},
	abstract = {Micro Data Videos (mDVs) are up to one-minute data-driven vertical video clips for mobile devices. Widely adopted on social media platforms, mDVs hold significant potential for disseminating information. Despite their growing prevalence, little is known about their components and how they are designed. Thus, two studies were conducted. Study 1 analyzed 40 mDVs and revealed their narrative components. Study 2 examined, through design sessions with design experts, how such components are assembled to craft storyboards for mDVs. The diverse narrative styles of mDVs render them flexible and suitable for multiple topics and purposes. Further, many include a “Linker” directing viewers to external online resources. Participants approached their design in a structural yet iterative manner with emphasis on setting up a “hook” in the opening seconds to capture attention. We summarize and share common design practices used in creating mDVs, an increasingly important medium in data storytelling. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {data storytelling; mobile data video; Narrative visualization; qualitative analysis; short video; video design},
	keywords = {Data visualization; Human engineering; Interactive computer systems; Iterative methods; Mobile telecommunication systems; Video analysis; Video recording; Data storytelling; Data Video; Design practice; Key elements; Mobile data; Mobile data video; Narrative visualization; Qualitative analysis; Short video; Video design; Information dissemination},
	publisher = {Association for Computing Machinery},
	issn = {25730142},
	language = {English},
