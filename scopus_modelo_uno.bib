	author = {Errey, Nina and Zowghi, Didar and Leong, Tuckwah Wah and Wu, Yadong and Yuan, Xiaoru and Huang, Weidong and Liang, Christy Jie},
	title = {Heuristics for evaluating narrative visualization: a validation study},
	year = {2025},
	journal = {Journal of Visualization},
	volume = {28},
