@ARTICLE{Kempeneer202565,
	author = {Kempeneer, Shirley and Wolswinkel, Johan and van Maanen, Gijs},
	title = {Beyond the Portal: Increasing Citizen Understanding of OGD with Storytelling},
	year = {2025},
