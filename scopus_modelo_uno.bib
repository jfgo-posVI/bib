@ARTICLE{Keith Norambuena2022220,
	author = {Keith Norambuena, Brian and Mitra, Tanushree and North, Chris L.},
	title = {Design guidelines for narrative maps in sensemaking tasks},
	year = {2022},
	journal = {Information Visualization},
