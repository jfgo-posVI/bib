}

@ARTICLE{Brich20242092,
	author = {Brich, Irina R. and Papenmeier, Frank and Huff, Markus and Merkt, Martin},
	title = {Construction or updating? Event model processes during visual narrative comprehension},
	year = {2024},
	journal = {Psychonomic Bulletin and Review},
	volume = {31},
	number = {5},
	pages = {2092 - 2101},
	doi = {10.3758/s13423-023-02424-w},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185149681&doi=10.3758%2Fs13423-023-02424-w&partnerID=40&md5=e0a02602cb62e5919f4e10ec6569c73b},
	affiliations = {Leibniz-Institut für Wissensmedien, Tubingen, Germany; Eberhard Karls Universität Tübingen, Department of Psychology, Tubingen, Germany; German Institute for Adult Education – Leibniz Centre for Lifelong Learning, Bonn, Germany},
	abstract = {The plot of a narrative is represented in the form of event models in working memory. Because only parts of the plot are actually presented and information is continually changing, comprehenders have to infer a good portion of a narrative and keep their mental representation updated. Research has identified two related processes (e.g., Gernsbacher, 1997): During model construction (shifting, laying a foundation) at large coherence breaks an event model is completely built anew. During model updating (mapping) at smaller omissions, however, the current event model is preserved, and only changed parts are updated through inference processes. Thus far, reliably distinguishing those two processes in visual narratives like comics was difficult. We report a study (N = 80) that aimed to map the differences between constructing and updating event models in visual narratives by combining measures from narrative comprehension and event cognition research and manipulating event structure. Participants watched short visual narratives designed to (not) contain event boundaries at larger coherence breaks and elicit inferences through small omissions, while we collected viewing time measures as well as event segmentation and comprehensibility data. Viewing time, segmentation, and comprehensibility data were in line with the assumption of two distinct comprehension processes. We thus found converging evidence across multiple measures for distinct model construction and updating processes in visual narratives. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Event Cognition; Event Models; Narrative Comprehension; Viewing Times; Adult; Comprehension; Female; Human; Male; Physiology; Reading; Short Term Memory; Verbal Communication; Young Adult; Adult; Comprehension; Female; Humans; Male; Memory, Short-term; Narration; Reading; Young Adult},
	keywords = {adult; comprehension; female; human; male; physiology; reading; short term memory; verbal communication; young adult; Adult; Comprehension; Female; Humans; Male; Memory, Short-Term; Narration; Reading; Young Adult},
	publisher = {Springer},
