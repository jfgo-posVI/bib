	year = {2023},
	journal = {Frontiers in Psychology},
	volume = {14},
	pages = {},
	doi = {10.3389/fpsyg.2023.1253509},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183642469&doi=10.3389%2Ffpsyg.2023.1253509&partnerID=40&md5=096eee7a525c8e340e59c87552b9370e},
	affiliations = {Linnaeus University, Växjö, Linnaeus Language Processing Lab, Vaxjo, Sweden; Institutionen för Kliniska Vetenskaper, Lund, Phoniatrics and Audiology, Lund, Sweden; Stockholms universitet, Department of Psychology, Stockholm, Sweden; Tilburg School of Humanities and Digital Sciences, Visual Language Lab, Tilburg, Netherlands},
	abstract = {There is a misconception that pictures are easy to comprehend, which is problematic in pedagogical practices that include pictures. For example, if a child has difficulties with verbal narration to picture sequences, it may be interpreted as specific to spoken language even though the child may have additional difficulties with comprehension of visual narratives in the form of picture sequences. The purpose of the present study was therefore to increase our understanding of semantic processing in the pictorial domain in relation to semantic processing in the verbal domain, focusing on 9–13 years-old children with typical language development. To this end, we measured electrical brain responses (event related potentials, ERPs) in 17 children to (i) pictures (panels) that were predicted versus unpredicted in sequences of panels that conveyed visual narratives and (ii) words that were predicted versus unpredicted in sentences that conveyed verbal narratives. Results demonstrated similarities as there were no significant difference in the magnitude of the N400 effect across domains. The only difference between domains was the predicted difference in distribution, that is, a more posterior N400 effect in the verbal domain than in the pictorial domain. The study contributes to an increased understanding of the complexity of processing of visual narratives and its shared features with processing of verbal narratives, which should be considered in pedagogical practices. © 2024 Elsevier B.V., All rights reserved.},
