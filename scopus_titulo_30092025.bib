@ARTICLE{Zhou2025,
	author = {Zhou, Di and Li, Taohui and Barakova, Emilia Ivanova and Chen, Chunxiao and Zhang, Jun},
	title = {Enhancing positive emotions and creativity in visual storytelling: the effect of multimedia transformation of drawings},
	year = {2025},
