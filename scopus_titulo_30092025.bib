@ARTICLE{Adornetti2020623,
	author = {Adornetti, Ines and Chiera, Alessandra and Deriu, Valentina and Altavilla, Daniela and Valeri, Giovanni and Marini, Andrea and Magni, Rita and Ferretti, Francesco},
	title = {Story processing in Autism Spectrum Disorder: Visual narrative as case study; L’ELABORAZIONE DELLE STORIE NEL DISTURBO DELLO SPETTRO AUTISTICO: IL CASO DELLE NARRAZIONI VISIVE},
	year = {2020},
	journal = {Sistemi Intelligenti},
	volume = {32},
	number = {3},
	pages = {623 - 647},
	doi = {10.1422/99079},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101581257&doi=10.1422%2F99079&partnerID=40&md5=71bdd5402237a93b3345230d290adddf},
	affiliations = {Università degli Studi Roma Tre, Dipartimento di Filosofia, Rome, Italy; IRCCS Ospedale Pediatrico Bambino Gesù, Department of Neuroscience, Rome, Italy; Università degli Studi di Udine, Comunicazione, Udine, Italy; Claudiana Research, Bolzano, Italy},
	abstract = {Impairments in language narrative abilities have been widely observed in Autism Spectrum Disorder (ASD). Indeed, both children and adults with ASD show difficulties in generating coherent personal and fictional narratives as well as understanding verbal stories. Cognitive studies have considered these difficulties as not dependent on strictly linguistic impairments but reflecting underlying cognitive deficits that are commonly used to explain the core symptoms of ASD: theory of mind impairment, weak central coherence, executive dysfunction, and a compromised mental time travel. Therefore, it has been hypothesized that the narrative deficits of ASD could extend to expressive media other than verbal language, e.g., the visual medium, whose processing might rely on those deeper cognitive functions. In support of this hypothesis, in the current paper we review the literature on the cognitive underpinnings of verbal and visual narrative in ASD and discuss the main findings of a study recently published on the comprehension of visual narrative in children with ASD, which shows that their difficulties are not restricted to the linguistic code but involve also the visual modality. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Autism Spectrum Disorder; Lobal Coherence; Narrative; Visual Narrative},
	publisher = {Societa Editrice Il Mulino},
	issn = {19738226; 11209550},
	language = {English},
