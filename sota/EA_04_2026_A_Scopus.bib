@ARTICLE{Feng2025,
author={Feng, X. and Prompongsaton, N. and Kotchapakdee, P.},
title={The Use of Nanyang han dynasty stone carved’ Mythological Elements in Printmaking Designs [Aplicación de elementos mitológicos de piedra de retrato de Nanyang han en el diseño de grabado]},
journal={Salud, Ciencia y Tecnologia - Serie de Conferencias},
year={2025},
