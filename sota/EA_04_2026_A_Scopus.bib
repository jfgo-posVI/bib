year={2025},
doi={10.1109/IACIS65746.2025.11211471},
note={cited By 0; Conference of 2nd International Conference on Intelligent Algorithms for Computational Intelligence Systems, IACIS 2025 ; Conference Date: 22 August 2025 Through 23 August 2025;  Conference Code:214622},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023640748&doi=10.1109%2fIACIS65746.2025.11211471&partnerID=40&md5=811e874d1f67440087b80228ebd3fcf0},
affiliation={New Horizon College of Engineering, Department of Ai&ml, Bengaluru, India; Dayananda Sagar College of Engineering, Department of CSE(IoT), Bengaluru, India; Jss Science and Technology University, Department of Computer Applications, Mysuru, India; Jss Science and Technology University, Department of Electronics and Communication Engineering, Mysuru, India; Dayananda Sagar College of Engineering, Department of Electronics and Communication Engineering, Bengaluru, India},
abstract={The automatic colorization of grayscale images is a longstanding and complex challenge in image processing and computer vision, primarily due to the ambiguous and multimodal nature of color inference. To address this, we propose a context-aware deep learning framework that utilizes convolutional neural networks (CNNs) for the automated colorization of black-and-white images. Our method is trained on a diverse dataset of paired grayscale and color images, enabling the model to learn semantically meaningful mappings between luminance and chrominance channels without relying on manual annotations or color hints. Through quantitative evaluations using metrics such as accuracy, recall, F1-score, and precision, the proposed model demonstrates superior performance compared to traditional machine learning techniques including KNN, SVM, and Random Forest. The results highlight enhanced color realism, semantic consistency, and robust generalization across diverse image categories such as landscapes, portraits, and historical photographs. These findings suggest the framework's strong potential for applications in historical image restoration, digital archiving, and creative visual storytelling. © 2025 IEEE.},
author_keywords={Automatic Colorization;  Computer Vision;  Convolutional Neural Networks;  Deep Learning;  Grayscale Image Restoration;  Image Colorization;  Image-to-Image Translation},
keywords={Color;  Color image processing;  Convolution;  Convolutional neural networks;  Deep neural networks;  Image annotation;  Image enhancement;  Image reconstruction;  Learning systems;  Restoration;  Semantics, Automatic colorization;  Context-Aware;  Convolutional neural network;  Deep learning;  Gray-scale images;  Grayscale image restoration;  Image colorizations;  Image translation;  Image-to-image translation;  Neural-networks, Computer vision},
