title={What makes a good story? Designing composite rewards for visual storytelling},
journal={AAAI 2020 - 34th AAAI Conference on Artificial Intelligence},
year={2020},
pages={7969-7976},
note={cited By 54; Conference of 34th AAAI Conference on Artificial Intelligence, AAAI 2020 ; Conference Date: 7 February 2020 Through 12 February 2020;  Conference Code:166426},
