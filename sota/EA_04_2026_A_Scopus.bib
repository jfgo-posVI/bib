@CONFERENCE{Cui2025,
author={Cui, S. and Kamal, J.B.I. and Chai, D.},
title={Revolutionizing Artistic Expression in Animated Filmmaking with Advanced Rendering Techniques},
journal={Proceedings ICECONF 2025 - 2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering},
year={2025},
doi={10.1109/ICECONF65644.2025.11379448},
note={cited By 0; Conference of 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering, ICECONF 2025 ; Conference Date: 9 October 2025 Through 10 October 2025;  Conference Code:220291},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034726302&doi=10.1109%2fICECONF65644.2025.11379448&partnerID=40&md5=e0c7607b21230983bad4d6e8d2aa5d20},
affiliation={School of Arts, Universiti Saints Malaysia, Penang, Malaysia; School of arts, University of Sanya, Hainan, China},
abstract={The evolution of animated filmmaking has faced significant challenges in integrating artistic expression with rapid technological progress. Traditional production and rendering techniques often limit the depth, realism, and creative flexibility of visual storytelling, thereby constraining the development of innovative narrative styles. In response to these limitations, emerging advanced rendering and artificial intelligence (AI) techniques-such as neural rendering, AI-based denoising, generative models, and intelligent styletransfer algorithms-are redefining the creative possibilities available to animators. This research aims to examine the transformative role of these new rendering and AI-driven methods in enhancing artistic expression within animation. Adopting a qualitative approach, the study follows a systematic literature review (SLR) guided by the PRISMA framework. It investigates major technological advancements and their influence on the artistic and cultural dimensions of animated filmmaking. From an initial pool of 50 relevant studies, 8 were rigorously analyzed to explore the relationship between rendering technologies, AI-enhanced workflows, and creative expression. The findings reveal that both improved rendering systems and AI-powered tools significantly enrich visual storytelling, increase production efficiency, and grant animators greater creative freedom. Moreover, AI techniques facilitate the preservation and reinterpretation of traditional artistic styles, thereby enhancing the cultural value of the final animated product. Overall, the study highlights the importance of integrating cutting-edge rendering innovations with AI methodologies to revolutionize Creative animation and provides insights into future research directions at the intersection of technology, culture, and digital artistry. © 2025 IEEE.},
author_keywords={advanced rendering techniques;  Animation;  artistic expression},
keywords={Artificial intelligence;  Rendering (computer graphics), Advanced rendering technique;  Artificial intelligence techniques;  Artistic expression;  Creatives;  De-noising;  Generative model;  Qualitative approach;  Systematic literature review;  Technological progress;  Visual storytellings, Animation},
