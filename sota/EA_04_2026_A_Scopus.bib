@CONFERENCE{Bazry2025214,
author={Bazry, Z.F. and Moniaga, J.V. and Pratama, G.D.},
title={Analysis of Core Drive on Narrative-Driven Games using Octalysis Framework: Case Study on The Last of Us Series},
