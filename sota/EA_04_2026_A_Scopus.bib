@CONFERENCE{Stoiber2023,
author={Stoiber, C. and Radkohl, S. and Grassinger, F. and Moitzi, D. and Stitz, H. and Goldgruber, E. and Girardi, D. and Aigner, W.},
title={Authoring tool for Data Journalists integrating Self-Explanatory Visualization Onboarding Concept for a Treemap Visualization},
journal={ACM International Conference Proceeding Series},
year={2023},
doi={10.1145/3605390.3605394},
art_number={2},
note={cited By 5; Conference of 15th Biannual Conference of the Italian SIGCHI Chapter: Crossing HCI and AI, CHItaly 2023 ; Conference Date: 20 September 2023 Through 22 September 2023;  Conference Code:192852},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173647244&doi=10.1145%2f3605390.3605394&partnerID=40&md5=887c1fd7fe926aa86bc2688681b71838},
affiliation={St. Pölten University of Applied Sciences, Austria; FH Joanneum University of Applied Sciences, Austria; Datavisyn GmbH, Austria},
abstract={Recipients of data stories need a certain visualization literacy level to understand and interpret more elaborate data visualizations correctly. For general audiences, however, visualization literacy levels are known to be relatively low. Therefore, journalists face the challenge that they are either restricted to using very simplistic representation techniques that are widely known or have to design and provide additional means to support readers in learning how to read and interpret a particular data visualization. In general, visualization onboarding methods might be utilized to support users in their individual information needs. But with the technology available to date, the effort needed to integrate such features is high and requires programming skills. To address this challenge, we conducted a design study to iteratively develop a proof-of-concept prototype that allows the semi-automatic creation of onboarding instructions for data-journalistic use cases. The implementation is based on a self-developed onboarding library integrated into the widely-used visualization framework called Flourish. To validate our prototype, user experience evaluations were conducted with seven (data) journalists. Our findings indicated that the journalists would provide simple onboarding instructions with fewer onboarding stages and simplified tooltip-based onboarding messages. The prototype can be accessed at http://bit.ly/3gBqrxv. © 2023 Owner/Author.},
author_keywords={authoring-tool;  data journalism;  treemap;  visualization onboarding},
keywords={Data visualization;  Iterative methods;  User interfaces, Authoring tool;  Data journalisms;  Design studies;  Onboarding;  Programming skills;  Proof of concept;  Representation techniques;  Treemap;  Treemap visualization;  Visualization onboarding, Visualization},
funding_details={Austrian Science FundAustrian Science Fund, FWF, I 5622-N},
