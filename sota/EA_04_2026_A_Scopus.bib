@CONFERENCE{Hsu20207952,
author={Hsu, C.-C. and Chen, Z.-Y. and Hsu, C.-Y. and Li, C.-C. and Lin, T.-Y. and Huang, T.-H. and Ku, L.-W.},
title={Knowledge-enriched visual storytelling},
journal={AAAI 2020 - 34th AAAI Conference on Artificial Intelligence},
year={2020},
pages={7952-7960},
note={cited By 37; Conference of 34th AAAI Conference on Artificial Intelligence, AAAI 2020 ; Conference Date: 7 February 2020 Through 12 February 2020;  Conference Code:166426},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85106444249&partnerID=40&md5=72427107afbb166f41c425fef0a5158f},
affiliation={University of Colorado Boulder, United States; Academia Sinica; Pennsylvania State University, United States; National Chiao Tung University, Taiwan; National Taiwan University, Taiwan; Most Joint Research Center for AI Technology, All Vista Healthcare},
abstract={Stories are diverse and highly personalized, resulting in a large possible output space for story generation. Existing end-to-end approaches produce monotonous stories because they are limited to the vocabulary and knowledge in a single training dataset. This paper introduces KG-Story, a three-stage framework that allows the story generation model to take advantage of external Knowledge Graphs to produce interesting stories. KG-Story distills a set of representative words from the input prompts, enriches the word set by using external knowledge graphs, and finally generates stories based on the enriched word set. This distill-enrich-generate framework allows the use of external resources not only for the enrichment phase, but also for the distillation and generation phases. In this paper, we show the superiority of KG-Story for visual storytelling, where the input prompt is a sequence of five photos and the output is a short story. Per the human ranking evaluation, stories generated by KG-Story are on average ranked better than that of the state-of-the-art systems. Our code and output stories are available at https://github.com/zychen423/KE-VIST. Copyright © 2020, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
keywords={Distillation, End to end;  External knowledge;  External resources;  State-of-the-art system;  Story generations;  Training dataset;  Visual storytellings, Knowledge representation},
