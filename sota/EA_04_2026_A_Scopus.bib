@ARTICLE{Raina2025591,
author={Raina, A. and Singh, S.K. and Oberoi, K. and Ramtirthkar, C.R. and Ikhar, S. and Bhosale, V.K.},
title={VISUAL EXPERIENCE DESIGN IN SMART TOURISM: INTELLIGENT SYSTEMS FOR PERSONALIZED CULTURAL AND TRAVEL NARRATIVES},
journal={ShodhKosh: Journal of Visual and Performing Arts},
year={2025},
volume={6},
number={5s},
