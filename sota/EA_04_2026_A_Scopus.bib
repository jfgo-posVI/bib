@ARTICLE{Hosseini202515,
author={Hosseini, A. and Wood, J. and Slingsby, A. and Jianu, R. and Elshehaly, M.},
title={What Do LLMs Prioritise When Adapting Visualizations to User Personas?},
journal={IEEE Workshop on Visual Analytics in Healthcare, VAHC},
year={2025},
number={2025},
pages={15-21},
doi={10.1109/VAHC69430.2025.00007},
note={cited By 0; Conference of 16th Workshop on Visual Analytics in Healthcare, VAHC 2025 ; Conference Date: 2 November 2025 Through 2 November 2025;  Conference Code:218614},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034060325&doi=10.1109%2fVAHC69430.2025.00007&partnerID=40&md5=4c41b783b707b40532706bcc65c87d1b},
affiliation={giCentre, City St George’s, University of London, United Kingdom},
abstract={Large Language Models (LLMs) are increasingly used for generating and adapting visualizations for different user groups. While recent efforts have focused on adapting visualizations to users' cognitive and perceptual abilities, how LLMs cater to the distinct interests and subjective priorities of various stakeholder groups remains largely unexplored. Specifically, LLMs utilise rhetorical elements to prioritise data stories, which can shape user interpretation. We present a systematic approach to assessing how LLMs adapt their visualization rhetoric to match the priorities of different user personas in a healthcare context. Based on qualitative interviews with population health stakeholders, we demonstrate LLMs' capabilities for (i) understanding user tasks and priorities from interview data, (ii) adapting visualizations to these priorities, and (iii) justifying design choices for the adaptations. Population health data presents an excellent space for experimentation, given: (a) the diversity of stakeholders (e.g., commissioners, population health experts, data analysts, and the public); and (b) the varied purposes and key messages for which visualizations are designed. We reflect on patterns in LLM reasoning about persona-specific design choices-in light of an established analytical framework for rhetorical visualization-and propose open questions to promote safer, more responsible practices in LLM-assisted visualization. ©2025 IEEE.},
author_keywords={Generative AI;  User Tasks;  Visualization},
keywords={Artificial intelligence;  Data visualization;  Population statistics, Data analysts;  Generative AI;  Health data;  Key message;  Language model;  Population health;  Qualitative interviews;  Stakeholder groups;  User groups;  User task, Flow visualization},
funding_details={Engineering and Physical Sciences Research CouncilEngineering and Physical Sciences Research Council, SRC},
