author={Song, Y. and Paperno, D. and Gatt, A.},
title={Context-aware Visual Storytelling with Visual Prefix Tuning and Contrastive Learning},
journal={INLG 2024 - 17th International Natural Language Generation Conference, Proceedings of the Conference},
year={2024},
pages={384-401},
doi={10.18653/v1/2024.inlg-main.32},
note={cited By 1; Conference of 17th International Natural Language Generation Conference, INLG 2024 ; Conference Date: 23 September 2024 Through 27 September 2024;  Conference Code:211922},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016703138&doi=10.18653%2fv1%2f2024.inlg-main.32&partnerID=40&md5=b04b51cda6d7ecc9a45d8c454184fb12},
affiliation={Utrecht University, Utrecht, Netherlands},
abstract={Visual storytelling systems generate multi-sentence stories from image sequences. In this task, capturing contextual information and bridging visual variation bring additional challenges. We propose a simple yet effective framework that leverages the generalization capabilities of pretrained foundation models, only training a lightweight vision-language mapping network to connect modalities, while incorporating context to enhance coherence. We introduce a multimodal contrastive objective that also improves visual relevance and story informativeness. Extensive experimental results, across both automatic metrics and human evaluations, demonstrate that the stories generated by our framework are diverse, coherent, informative, and interesting. © 2024 Association for Computational Linguistics.},
keywords={Computational linguistics;  Natural language processing systems;  Visual languages, Context-Aware;  Contextual information;  Foundation models;  Generalization capability;  Image sequence;  Informativeness;  Language mapping;  Multi-modal;  Simple++;  Visual storytellings, Contrastive Learning},
