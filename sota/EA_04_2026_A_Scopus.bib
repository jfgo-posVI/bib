@CONFERENCE{Su20242845,
author={Su, J. and Chen, W. and Ji, Y. and Liu, C.},
title={GLOCAL CASCADING NETWORK FOR TOPIC ENHANCED VISUAL STORYTELLING},
journal={ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
year={2024},
pages={2845-2849},
doi={10.1109/ICASSP48485.2024.10447361},
note={cited By 0; Conference of 2024 IEEE International Conference on Acoustics, Speech, and Signal Processing, ICASSP 2024 ; Conference Date: 14 April 2024 Through 19 April 2024;  Conference Code:199684},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195403787&doi=10.1109%2fICASSP48485.2024.10447361&partnerID=40&md5=d3baa8d5c81063e09ca26d439dca72f3},
affiliation={School of Computer Science and Technology, Soochow University, China},
abstract={As a cross-modal task, visual storytelling aims to generate a semantically coherent story for an ordered image sequence. Despite significant achievements in existing methods for this task, few works focus on improving the conception ability which humans usually use when writing stories. In this work, we propose a framework called GLocal Cascading Network for Topic Enhanced Visual Storytelling which explores the conception ability by pre-modeling a latent topic for each image during story telling. Inspired by the global-local (glocal) ideology, we firstly propose a hierarchical latent-topic decoder consisting of two levels of topic generator which respectively focus on different levels of topic information. Then we propose a topic-aware loss which encourages the model to focus on the topic information of the story. With these two novel modules, our framework can effectively utilize the topic information and improve the informativeness and consistency of stories. Our model has been proven highly competitive across multiple metrics through extensive experiments conducted on the VIST dataset. © 2024 IEEE.},
author_keywords={GLocal Cascading Network;  Topic;  Visual Storytelling},
funding_details={Priority Academic Program Development of Jiangsu Higher Education InstitutionsPriority Academic Program Development of Jiangsu Higher Education Institutions, PAPD},
funding_details={National Natural Science Foundation of ChinaNational Natural Science Foundation of China, NSFC, 62376041},
