@CONFERENCE{Kalnis202512,
author={Kalnis, P. and Shang, S. and Jensen, C.S.},
title={Comprehending Spatio-temporal Data via Cinematic Storytelling using Large Language Models},
journal={SSTD 2025 - Proceedings of the 19th International Symposium on Spatial and Temporal Data},
year={2025},
pages={12-16},
doi={10.1145/3748777.3748787},
note={cited By 0; Conference of 19th International Symposium on Spatial and Temporal Data, SSTD 2025 ; Conference Date: 25 August 2025 Through 27 August 2025;  Conference Code:213775},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021931775&doi=10.1145%2f3748777.3748787&partnerID=40&md5=613f49c4f5d88ad8d73731499b0d4a4c},
affiliation={King Abdullah University of Science and Technology, Thuwal, Saudi Arabia; University of Electronic Science and Technology of China, Chengdu, China; Aalborg University Aalborg University, Denmark},
abstract={Spatio-temporal data captures complex dynamics across both space and time, yet traditional visualizations are complex, require domain expertise and often fail to resonate with broader audiences. Here, we propose MapMuse, a storytelling-based framework for interpreting spatio-temporal datasets, transforming them into compelling, narrative-driven experiences. We utilize large language models and employ retrieval augmented generation (RAG) and agent-based techniques to generate comprehensive stories. Drawing on principles common in cinematic storytelling, we emphasize clarity, emotional connection, and audience-centric design. As a case study, we analyze a dataset of taxi trajectories. Two perspectives are presented: a captivating story based on a heat map that visualizes millions of taxi trip endpoints to uncover urban mobility patterns; and a detailed narrative following a single long taxi journey, enriched with city landmarks and temporal shifts. By portraying locations as characters and movement as plot, we argue that data storytelling drives insight, engagement, and action from spatio-temporal information. The case study illustrates how MapMuse can bridge the gap between data complexity and human understanding. The aim of this short paper is to provide a glimpse to the potential of the cinematic storytelling technique as an effective communication tool for spatio-temporal data, as well as to describe open problems and opportunities for future research. © 2025 Copyright held by the owner/author(s)},
author_keywords={Agents;  LLM;  MapMuse;  RAG;  Spatial;  Temporal;  Trajectories},
keywords={Computational methods;  Data visualization;  Human engineering;  Interactive computer graphics;  Large datasets;  Spatio-temporal data;  Taxicabs, Case-studies;  Cinematics;  Complex dynamics;  Language model;  LLM;  Mapmuse;  Retrieval augmented generation;  Spatial;  Spatio-temporal data;  Temporal, Trajectories},
funding_details={King Abdullah University of Science and TechnologyKing Abdullah University of Science and Technology, KAUST},
funding_text 1={AI-generated content. The paper is dealing with the automatic generation of stories that explain spatio-temporal data. All stories appearing in the paper were generated by AI. Figures 2 and 3 were partially generated by AI. In all cases, we used ChatGPT-4o. Computational resources. For computer time, this research used IBEX and Shaheen III, managed by the Supercomputing Core Laboratory at King Abdullah University of Science and Technology (KAUST), Saudi Arabia.},
