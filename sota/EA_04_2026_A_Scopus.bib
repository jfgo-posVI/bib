author={Norris, W. and Voida, A. and Voida, S.},
title={People Talk in Stories. Responders Talk in Data: A Framework for Temporal Sensemaking in Time- and Safety-critical Work},
journal={Proceedings of the ACM on Human-Computer Interaction},
year={2022},
volume={6},
number={CSCW1},
doi={10.1145/3512955},
art_number={108},
note={cited By 6},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128389640&doi=10.1145%2f3512955&partnerID=40&md5=37913994f97599301dad8d3020a7069c},
affiliation={Nazareth College, Rochester, NY, United States; University of Colorado Boulder, Boulder, CO, United States},
abstract={Global crowdsourcing teams who conduct humanitarian response use temporal narratives as a sensemaking device when time is a critical element of the data story. In dynamic situations in which the flow of online information is rapid, fluid, and disordered, the process of how distributed teams construct a temporal narrative is not well understood nor well supported by information and communication technologies (ICTs). Here, we examine an intense need for temporal sensemaking: time- and safety-critical information work during the 2017 Hurricane Maria crisis response in Puerto Rico. Our analysis of semi-structured interviews reveals how members of a global digital humanitarian group, The Standby Task Force (SBTF), use a process of triage, evaluation, negotiation, and synchronization to construct collective temporal narratives in their high-tempo, distributed information work. Informed by these empirical insights, we reflect on the design implications for cloud-based, collaborative ICTs used in time- and safety-critical remote work. © 2022 Owner/Author.},
author_keywords={crisis informatics;  digital humanitarian;  distributed work;  sensemaking;  sociotemporality;  temporal coordination},
keywords={Crisis informatics;  Critical elements;  Digital humanitarian;  Distributed work;  Information and Communication Technologies;  Online information;  Safety critical work;  Sense making;  Sociotemporality;  Temporal coordination, Safety engineering},
funding_details={National Science FoundationNational Science Foundation, NSF, IIS-1564275},
funding_text 1={This research was supported by US NSF grant IIS-1564275. Thank you to the anonymous reviewers for their thoughtful and constructive feedback that immeasurably helped to improve this work. We are also deeply grateful to The Standby Task Force (SBTF), the study participants, and our colleagues with Project EPIC, the Philanthropic Informatics Research Lab (PIRL), and the Too Much Information (TMI) Lab for their support.},
