@ARTICLE{Gholami20257,
author={Gholami, P. and Farahbakhsh, A.},
title={A Hutcheonian reading of Liv Ullmann’s film adaptation of August Strindberg’s Miss Julie},
journal={Journal of Scandinavian Cinema},
year={2025},
