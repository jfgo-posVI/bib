@CONFERENCE{Bierlee2025566,
author={Bierlee, C.K. and Prawira, I.},
title={Deepfakes and Their Impacts on Visual Storytelling in Media Industries: A Literature Review},
journal={Proceedings of 2025 International Conference on Information Management and Technology, ICIMTech 2025},
year={2025},
pages={566-571},
doi={10.1109/ICIMTech67074.2025.11264847},
note={cited By 0; Conference of 10th International Conference on Information Management and Technology, ICIMTech 2025 ; Conference Date: 28 August 2025 Through 29 August 2025;  Conference Code:217730},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105031397774&doi=10.1109%2fICIMTech67074.2025.11264847&partnerID=40&md5=d2b65664701bacda85ff40ca69e403f5},
affiliation={Bina Nusantara University, Faculty of Digital Communication and Hotel & Tourism, Mass Communication Program, Communication Department, Jakarta, 11480, Indonesia},
abstract={The development of deepfake applications has transformed visual storytelling, which presents both opportunities and threats in the media industry. This study explores the impact of deepfakes on content production in media industries, particularly those focused on visual storytelling. Using an audience trust and media authenticity theoretical framework, this study adopts a systematic literature review (SLR) method that explores 31 papers published from 2019 to 2025. The findings reveal that deepfakes create new creative opportunities, including the ability to recreate historical events, enhance artistic expression, and resurrect actors who have passed away. However, deepfakes also provide serious concerns, such as misinformation and moral concerns. The application of trustworthy watermarking technology, ethical concerns, and legal approvals are challenges faced by media professionals. Another significant finding is that deepfakes undermine audience trust, as it becomes increasingly difficult for audiences to tell the difference between authentic and generated content. The perceived originality and credibility of the media may be weakened by this ambiguity. While this research is entirely based on existing literature, the results of this study establish a foundation for future research employing survey-based or experimental methodologies to further explore how audiences view or react to deepfake-generated content in various contexts. © 2025 IEEE.},
author_keywords={deepfake;  deepfake consequences;  deepfake impact;  media industries;  systematic literature review;  visual storytelling},
keywords={Content production;  Creatives;  Deepfake;  Deepfake consequence;  Deepfake impact;  Literature reviews;  Media industry;  Systematic literature review;  Theoretical framework;  Visual storytellings, Reviews},
funding_details={Binus UniversityBinus University, BINUS},
funding_text 1={The authors would like to sincerely thank Grammarly for helping correct the grammar mistakes and offering helpful suggestions. We would also like to express our gratitude to Zenodo for providing an open-access platform to share our research data. Additionally, we are grateful to Bina Nusantara University for providing the facilities and resources required to finish this study.},
