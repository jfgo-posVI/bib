@CONFERENCE{Chen202415617,
author={Chen, W. and Li, X. and Su, J. and Zhu, G. and Li, Y. and Ji, Y. and Liu, C.},
title={TARN-VIST: Topic Aware Reinforcement Network for Visual Storytelling},
