@CONFERENCE{Hsu20214443,
author={Hsu, C.-Y. and Chu, Y.-W. and Huang, T.-H. and Ku, L.-W.},
title={Plot and Rework: Modeling Storylines for Visual Storytelling},
journal={Findings of the Association for Computational Linguistics: ACL-IJCNLP 2021},
year={2021},
pages={4443-4453},
doi={10.18653/v1/2021.findings-acl.390},
note={cited By 21; Conference of Findings of the Association for Computational Linguistics: ACL-IJCNLP 2021 ; Conference Date: 1 August 2021 Through 6 August 2021;  Conference Code:174271},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123928682&doi=10.18653%2fv1%2f2021.findings-acl.390&partnerID=40&md5=8fc25d39be808734461959ce9aa70ae3},
affiliation={Pennsylvania State University, United States; Purdue University, United States; Institute of Information Science, Academia Sinica, Taiwan},
abstract={Writing a coherent and engaging story is not easy. Creative writers use their knowledge and worldview to put disjointed elements together to form a coherent storyline, and work and rework iteratively toward perfection. Automated visual storytelling (VIST) models, however, make poor use of external knowledge and iterative generation when attempting to create stories. This paper introduces PR-VIST, a framework that represents the input image sequence as a story graph in which it finds the best path to form a storyline. PR-VIST then takes this path and learns to generate the final story via a re-evaluating training process. This framework produces stories that are superior in terms of diversity, coherence, and humanness, per both automatic and human evaluations. An ablation study shows that both plotting and reworking contribute to the model's superiority. © 2021 Association for Computational Linguistics},
keywords={Best paths;  Creatives;  External knowledge;  Image sequence;  Input image;  Iterative generation;  Knowledge generations;  Learn+;  Storylines;  Visual storytellings},
funding_details={Pennsylvania State UniversityPennsylvania State University, PSU},
funding_details={Ministry of Science and Technology, TaiwanMinistry of Science and Technology, Taiwan, MOST, 108-2221-E-001-012-MY3, 108-2923-E-001-001-MY2},
funding_details={Ministry of Science and Technology, TaiwanMinistry of Science and Technology, Taiwan, MOST},
funding_details={Instituto Superior TécnicoInstituto Superior Técnico, IST},
