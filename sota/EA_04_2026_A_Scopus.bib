@CONFERENCE{Feng2025,
author={Feng, Z. and Hu, P.},
title={From Gambling to Storytelling: Reimagine Slot Games for Intersectional Narratives in Kevin},
journal={Conference on Human Factors in Computing Systems - Proceedings},
year={2025},
doi={10.1145/3706599.3720322},
art_number={888},
note={cited By 0; Conference of 2025 CHI Conference on Human Factors in Computing Systems, CHI EA 2025 ; Conference Date: 26 April 2025 Through 1 May 2025;  Conference Code:208611},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005772457&doi=10.1145%2f3706599.3720322&partnerID=40&md5=e8cb13366df4ef74bda091378316915a},
affiliation={Rensselaer polytechnic institute, Troy, NY, United States; Donghua University, Shanghai, China},
abstract={Contemporary video games often equate narrative agency with complex player choices, thereby complicating interface design. This study challenges this trend by developing Kevin, a slot game that integrates simplistic haptic interaction into interactive storytelling. Kevin is designed based on the common 243-way slot games, with gameplay centered around the protagonist Kevin’s college life. Furthermore, we root our narrative design in the intersectionality framework by exploring the multifaceted nature of Kevin’s identities. Based on player feedback, we found that the contrast between the simple button interaction and the game’s visual storytelling creates compelling narrative tension. However, we also identified certain limitations in balancing critical perspectives with dramatic plots and addressing ludic literacy. Accordingly, we propose directions for future research and design looking to repurpose slot games. © 2025 Copyright held by the owner/author(s).},
author_keywords={agency;  emergent narrative;  haptic interface;  interactive storytelling;  intersectionality;  Slot games;  The authors want to thank all the participants who provided valuable feedback during game testing sessions},
keywords={Interactive computer graphics, Agency;  Emergent narrative;  Game testing;  Haptics interfaces;  Interactive storytelling;  Intersectionality;  Slot game;  Testing sessions;  The author want to thank all the participant who provided valuable feedback during game testing session;  Video-games, Haptic interfaces},
