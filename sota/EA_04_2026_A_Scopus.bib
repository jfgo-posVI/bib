@ARTICLE{PortodeAlbuquerque2023,
author={Porto de Albuquerque, J. and Anderson, L. and Calvillo, N. and Cattino, M. and Clarke, A. and Cunha, M.A. and Garde-Hansen, J. and Klonner, C. and Lima-Silva, F. and Marchezini, V. and Martins, M.H.D.M. and Pajarito Grajales, D. and Pitidis, V. and Rizwan, M. and Tkacz, N. and Trajber, R.},
title={Dialogic data innovations for sustainability transformations and flood resilience: The case for waterproofing data},
journal={Global Environmental Change},
year={2023},
volume={82},
doi={10.1016/j.gloenvcha.2023.102730},
art_number={102730},
note={cited By 18},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166305554&doi=10.1016%2fj.gloenvcha.2023.102730&partnerID=40&md5=c0919a027b6b290f0f648a7c2f15209a},
affiliation={University of Glasgow, Glasgow, United Kingdom; Heidelberg University, Heidelberg, Germany; Fundacao Getulio Vargas, São Paulo, Brazil; University of Warwick, Coventry, United Kingdom; National Centre for Disaster Monitoring and Early Warning (Cemaden), São José dos Campos, Brazil; Universidade Federal de São Carlos (UFSCar), São Carlos, Brazil},
abstract={Extreme weather events are becoming more frequent and have increasing impacts, which disproportionately affect marginalised and impoverished communities. This article proposes and assesses a new methodological approach for developing innovative solutions based on urban data analytics to address sustainability challenges in light of changing climate conditions. The approach draws inspiration from Paulo Freire's dialogic pedagogy and has been implemented in the international transdisciplinary project “Waterproofing Data”, with multiple study sites in Brazil. The project has introduced three methodological interventions: making data practices visible, engaging citizens and communities with data, and sharing data stories. Our study demonstrates that these methods have expanded the types of data used in flood risk management and have engaged a wider range of social groups in the generation, circulation, and utilization of data. We present a framework that provides guidance about the ways in which data innovations can contribute to transformative change, aiming to ensure that future development trajectories are just, inclusive, and equitable. The findings provide evidence that our approach not only helps fill existing data gaps and promote more equitable flood risk governance but also democratises decision-making in climate adaptation. Citizens were empowered to take proactive measures to improve resilience to disaster risks, thereby saving lives and safeguarding livelihoods. © 2023 The Author(s)},
author_keywords={Climate adaptation;  Critical pedagogy;  Disaster risk;  Floods;  Participatory urban analytics;  Resilience;  Sustainability;  Transformations;  Urban data},
keywords={climate change;  flood;  governance approach;  innovation;  interdisciplinary approach;  participatory approach;  risk assessment;  sustainability;  urban area;  waterproofing, Brazil},
funding_details={Economic and Social Research CouncilEconomic and Social Research Council, ESRC, ES/S006982/2},
funding_text 1={The work for this article is the result of a collaborative knowledge co-production process to which many people have contributed. Despite our best efforts to distil lessons from this collective work in this article, the authors take responsibility for its content alongside any potential errors and omissions, whilst also acknowledging the crucial contribution of the very many people who interacted and contributed to our project in several different roles. Conscious of the difficulty of mapping out all collaborators, we would like to express our gratitude and debt to all of them but also explicitly recognise the contributions of the following people:, \u2013 Co-Investigaros: Giovanni Dolif, Conrado Rudorff, Jon Coaffee, Alexander Zipf, Flavio E. A. Horita. \u2013 Research Assistants in Brazil: Ana Maria Gon\u00E7alves Cruz, Aniely Araujo Porto, Caio Cruz, Diego Ramos, Fabio L\u00FAcio, Gabriel Brand\u00E3o, Guilherme Prado, Guilherme Reis, Iasmin Castro, Jennifer Andrade, Veridiana Santana. \u2013 Research Assistants in Germany: Hartmann, Maximilian, Djami, Lily, Dischl, Rebecca, Reimer, Michelle, Mallmann, Yannik, Schuchardt, Leonie. \u2013 Project administrators: Stephanie Whitehead, Leigh Walker, Simon Smith, Clare Roberts. \u2013 Software developers: Ana Luiza Figueiredo, Gabriel Trettel, Bruno Aristimunha, Daniel D'Angelo R. Barros, Jean Neves, Yan Marques. \u2013 Audiovisual professionals: Juliana Brombim, Lucas Louren\u00E7o. \u2013 Local partners (schools and communities): Dayane Almeida, Edna Sandes, Fatima Suzuki, Francicleia Barrozo, Jos\u00E9 Herc\u00EDlio Pessoa de Oilveira, Mara Luperin, Vera Reis, Marilene dos Santos, Rosineia Frota, Sirlene Luz, Marcos Willyan Gomes da Silveira, Cel James Joyce Bezerra Gomes, Cel George Luiz Pereira Santos, Simone Silva, Ylza Marluce Silva de Lima. \u2013 Pollination facilitators/pedagogical team: D\u00E9bora Olivato, Doroty Aparecida Martos, Adriana Lippi, Maria Francisca Velloso. \u2013 Pollinators: Erlange de Ara\u00FAjo Damasceno, James Joyce Bezerra Gomes, Rodrigo de Souza Gomes, Maria Rosineia da Silva Frota, Eronaldo Assun\u00E7\u00E3o Valles, Giselly Rodrigues das Neves Silva Gomes, D\u00E9borah Lu\u00EDza Moreira Santana Santos, Benedito Augusto Nunes da Silva Freitas, Danilo Santos do Vale, Rejane Lucena Bet\u00E2nia Queiroz da SIlva, Augusto Ribeiro da Silva, Douglas Teixeira Luciano Peri, Regina Panceri, Rosinei da Silveira, Dayane Almeida de Sousa, Rosa Maria de Sousa Santos, Orlando Santos, Carolina Lopes de Oliveira Ramos, Cheila Fl\u00E1via de Praga Bai\u00E3o. The authors are also grateful to Mario de Theije, Philipp Ulbrich and Fabio de Castro, as well as to the anonymous reviewers for their very useful comments in previous versions of this article.},
