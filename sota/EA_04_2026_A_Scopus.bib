@CONFERENCE{Gayathri2025,
author={Gayathri, H. and Mathew, J. and Johnson, J. and Vasudevan, K. and Gisha, G.S.},
title={Stable Diffusion for Narrative Illustration: Transforming Text into Visual Art},
journal={3rd International Conference on Networks and Advances in Computational Technologies, NetACT 2025},
year={2025},
doi={10.1109/NetACT65906.2025.11188959},
note={cited By 0; Conference of 3rd International Conference on Networks and Advances in Computational Technologies, NetACT 2025 ; Conference Date: 7 August 2025 Through 9 August 2025;  Conference Code:213673},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020805098&doi=10.1109%2fNetACT65906.2025.11188959&partnerID=40&md5=e83d797de327bcf0eb638bd145483406},
affiliation={LBS Institute of Technology for Women, Department of Computer Science and Engineering, Thiruvananthapuram, India},
abstract={In today's digital age, where technology continuously reshapes creative expression, this paper presents a system that transforms written narratives into fully illustrated comic books by combining Natural Language Processing and Stable Diffusion techniques. The proposed solution employs Google's Gemini model to analyze and summarize user-submitted stories, breaking them into key segments for illustration. Each segment is used to generate contextually accurate images via the Stable Diffusion XL model, ensuring visual consistency and relevance. Unlike traditional generative approaches such as Generative Adversarial Networks, which often require extensive training and struggle with multi panel coherence, Stable Diffusion delivers high-quality illustrations with lower computational overhead. The system is implemented as a web application, allowing users to upload stories, receive summarized captions, and view illustrated outputs either as a downloadable comic book or a narrated visual sequence. Key contributions of this work include a text-to-comic generation pipeline integrating large language models and text-toimage diffusion, a novel approach for context-preserving prompt generation at the sentence level and a resource-efficient implementation requiring no dedicated GPU. The results demonstrate the system's effectiveness in producing stylistically consistent illustrations with minimal human intervention. This framework holds significant promise across domains such as education, entertainment, accessibility, and digital marketing, enabling inclusive and scalable visual storytelling. © 2025 IEEE.},
keywords={Arts computing;  Electronic commerce;  Marketing;  Natural language processing systems, Adversarial networks;  Breakings;  Creatives;  Digital age;  Google+;  Key-segment;  Language processing;  Natural languages;  Visual arts;  Visual consistency, Diffusion},
references={Warrier, A., Mathew, A., Patra, A., Hiremath, K.S., Jijo, J., Generation and Editing of Faces using Stable Diffusion with Criminal Suspect Matching (2024) 2024 IEEE International Conference on Advanced Systems and Emergent Technologies (IC ASET), pp. 1-6. , Hammamet, Tunisia; Zhang, Y., Zhang, T., Xie, H., TexControl: Sketch-Based Two-Stage Fashion Image Generation Using Diffusion Model (2024) 2024 Nicograph International (NicoInt), pp. 64-68. , Hachioji, Japan; Diana Earshia, V., Venkata Hemanth Kumar, V., Dinesh Kumar, R., Moni Sahithi, V., Generation of Hilarious Animated Characters using GAN 2023 7th International Conference on Trends in Electronics and Informatics (ICOEI), pp. 63-66. , Tirunelveli, India; Yu, K., Kim, H., Kim, J., Chun, C., Kim, P., A Study on Webtoon Generation Using CLIP and Diffusion Models (2023) Electronics, 12 (18), p. 3983. , Sep; Popuri, A., Miller, J., Generative Adversarial Networks in Image Generation and Recognition (2023) 2023 International Conference on Computational Science and Computational Intelligence (CSCI), pp. 1294-1297. , Las Vegas, NV, USA; Zakraoui, J., Saleh, M., Al-Maadeed, S., Alja'am, J.M., A Pipeline for Story Visualization from Natural Language (2023) Appl. Sci., 13 (8), p. 5107. , Apr},
publisher={Institute of Electrical and Electronics Engineers Inc.},
