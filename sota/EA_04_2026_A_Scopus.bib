@ARTICLE{Stocco2024151,
author={Stocco, S. and Rocca, L.},
title={Place-Based Education for Ocean Literacy: Fostering Ocean Literacy and Place Attachment through short film},
journal={J-Reading},
year={2024},
volume={2},
pages={151-166},
doi={10.4458/7417-11},
