pages={776-785},
note={cited By 1; Conference of 2024 International Annual Conference of the American Society for Engineering Management and 45th Annual Meeting: Engineering Management Riding the Waves of Smart Systems, ASEM 2024 ; Conference Date: 6 November 2024 Through 9 November 2024;  Conference Code:206770},
