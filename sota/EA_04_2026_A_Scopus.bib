@ARTICLE{Aditya2025293,
author={Aditya, D.K. and Dewa Alit Dwija Putra, I. and Desintha, S. and Gusti Agung Rangga Lawe, I. and Kusmayanti, I.N.},
title={Reimagining Wacinwa: Transforming a Chinese Javanese Puppet Tradition into a Modular Visual Storytelling System through Wuxia Narrative [保护 Wacinwa：通过武侠叙事将中爪木偶传统转化为视觉叙事系统]},
