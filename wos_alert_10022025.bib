@article{ WOS:001578030500004,
Author = {Auron, Moises and Amin, Alpesh N. and Brooks, Michelle N. and Sata,
   Suchita Shah},
Title = {Storytelling How to Make Data Meaningful?},
Journal = {MEDICAL CLINICS OF NORTH AMERICA},
Year = {2025},
Volume = {109},
Number = {5},
Pages = {969-980},
Month = {SEP},
Abstract = {Storytelling is a powerful yet often overlooked tool in health care QI.
   While data and metrics provide the foundation for decisions, the
   emotional connection created through storytelling engages teams, fosters
   a shared vision, and drives lasting change. The burning platform
   metaphor demonstrates how urgency can motivate action, but storytelling
   must be balanced to avoid crisis fatigue. Emotionally-compelling
   narratives make data more memorable, enhance understanding, and
   encourage behavioral change by connecting abstract statistics to real
   patient experiences. Compelling storytelling relies on clear structure,
   relevant data, and strong visualization, amplified through digital media
   such as social media, podcasts, and visual abstracts. By integrating
   storytelling into QI initiatives, health care leaders can inspire teams,
   improve communication, and ensure that QI efforts remain
   patient-centered. Ultimately, storytelling transforms numbers into
   meaning, making QI efforts more impactful and sustainable in pursuing
   better patient care.},
