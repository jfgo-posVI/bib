@article{ WOS:001568078400001,
Author = {He, Xiuchuan and Xue, Junjie and Ji, Yijing},
Title = {Mapping the Landscape of Immersive Technologies Integrating Narrative:
   Bibliometric Insights from CiteSpace},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER INTERACTION},
Year = {2025},
Month = {2025 SEP 9},
Abstract = {With the rapid development of computer vision and human-computer
   interaction technologies, the narrative of immersive technology
   integration represented by virtual reality has received increasing
   attention. However, contemporary research in this field is usually based
   on specific aspects and lacks a holistic perspective. To address this
   problem, this study searched for literature on immersive
   technology-integrated narratives (ITINA) in the Web of Science core
   database and selected 1,721 documents between 1999 and 2024. The
   findings cover publications, collaborations, influential sources, and
   popular topics. They not only provide a comprehensive picture of the
   field's evolution but also construct a knowledge framework for future
   research, especially in interdisciplinary applications, emerging
   technologies convergence, user experience, and ethical responsibility.
   The innovation is to explore in depth the results of 25 years of
   research and to simplify the understanding of complex content through
   graphical visualisations. This study provides a valuable perspective in
   the field.},
