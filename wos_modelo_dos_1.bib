@article{ WOS:001431388900001,
Author = {Becker, Jennifer A. H.},
Title = {Beyond Beer and Bratwurst: German Texans' Storytelling Through the
   Lenses of Communicated Narrative Sense-Making Theory and Communication
   Theory of Resilience},
Journal = {COMMUNICATION STUDIES},
Year = {2025},
Volume = {76},
Number = {5},
Pages = {511-529},
Month = {SEP 3},
Abstract = {This study examines how German Texans retrospectively tell
   intergenerational stories of resilience about their families' lived
   experiences in the mid-to-late 1800s to the early-to-mid 1900s. The
   theoretical foundations of the study are the retrospective storytelling
   heuristic of communicated narrative sense-making (CNSM) theory and the
   communication theory of resilience (CTR). I applied thematic narrative
   analysis to identify the frame of resilience story present in the data
   of 13 oral history interviews of German Texans from the archives of the
   Institute of Texan Cultures. Two story frames emerged: (1) s \&
   aacute;chlich stories (which are told matter-of-factly and reflect
   German Kultur) and (2) stories of triumph. Additionally, I used the
   constant comparative approach to identify common themes across the 13
   oral history interviews. Interviewees crafted six communication
   processes of resilience. In order of frequency within the data, these
   processes were (1) crafting normalcy, (2) maintaining and using
   communication networks, (3) affirming identity anchors, (4) reporting
   historical facts and lore {[}a new process that extends CTR], (5)
   legitimizing negative feelings while foregrounding productive action,
   and (6) putting alternative logics to work. These findings support and
   advance CNSM theory and CTR and demonstrate the value of drawing upon
   oral histories in the studies of storytelling, resilience, and
   communication broadly. Many of our current theories are bound by
   assumptions tied to the present. As the nature of lived experiences
   evolves, using oral histories can illustrate, test, and extend theories
   in new ways.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
