@article{ WOS:000869148500001,
Author = {Dragan, Nicolae-Sorin and Farte, Gheorghe-Ilie},
Title = {The multimodal construction of political personae through the
   strategic management of semiotic resources of emotion expression},
Journal = {SOCIAL SEMIOTICS},
Year = {2024},
Volume = {34},
Number = {3},
Pages = {464-488},
Month = {MAY 26},
Abstract = {This paper presents an analytical framework for analyzing how multimodal
   resources of emotion expression are semiotically materialized in
   discursive interactions specific to political discourse. Interested in
   how political personae are emotionally constructed through multimodal
   meaning-making practices, our analysis model assumes an
   interdisciplinary perspective, which integrates facial expression
   analysis - using FaceReader (TM) software -, the theory of emotional
   arcs and bodily actions (hand gestures) analysis that express emotions,
   in the analytical framework of multimodality. The results show how the
   multimodal choices that political actors make during discursive
   interactions allow them to build their political brand and make
   connections with the audience on an emotional level.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
