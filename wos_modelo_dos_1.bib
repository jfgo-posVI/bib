@article{ WOS:000923159900001,
Author = {Bobkowski, Piotr S. and Etheridge, Christopher E.},
Title = {Spreadsheets, Software, Storytelling, Visualization, Lifelong Learning:
   Essential Data Skills for Journalism and Strategic Communication
   Students},
Journal = {SCIENCE COMMUNICATION},
Year = {2023},
Volume = {45},
Number = {1, SI},
Pages = {95-116},
Month = {FEB},
Abstract = {To facilitate greater integration of statistical reasoning and data
   instruction in journalism and mass communication (JMC) college
   curricula, this research note advocates designing collective instruction
   for journalism and strategic communication students organized around the
   data literacy construct. It introduces a Data Project Lifecycle model
   that maps statistics, data, and computational skills discussed across
   the literature, and which can be used in instructional design. Input
   from 24 journalism and strategic communication practitioners with data
   experience identifies essential data skills for JMC graduates:
   spreadsheet wherewithal, fluency in industry-standard software, ability
   to tell compelling stories with data, visualization, and self-directed
   learning.},
