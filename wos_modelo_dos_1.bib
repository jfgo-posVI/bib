@article{ WOS:001226258200036,
Author = {Idiz, Daphne Rena},
Title = {Local Production for Global Streamers: How Netflix Shapes European
   Production Cultures},
Journal = {INTERNATIONAL JOURNAL OF COMMUNICATION},
Year = {2024},
Volume = {18},
Pages = {2129-2148},
Abstract = {This article examines how Netflix's increased production of local
   streaming content affects European television production practices. This
   inquiry is developed in critical dialogue with current research,
   primarily focused on the United States, which suggests that Netflix's
   production practices largely correspond with legacy practices in the
   television industry. The question is whether this observation also
   applies to Europe. Addressing this, 14 semi-structured interviews were
   conducted with television and film industry workers based in the
   Netherlands, Belgium, Germany, Denmark, and Spain. Emerging themes
   demonstrate that Netflix is reshaping production practices in these
   countries by importing a U.S. production model and influencing
   storytelling practices.},
