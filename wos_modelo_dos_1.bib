@article{ WOS:001502437000001,
Author = {Tsai, Wei-Ting and Wang, Ching-Hsing},
Title = {Personality Traits and Individual Attitudes Toward Transitional Justice:
   Evidence From Taiwan},
Journal = {INTERNATIONAL JOURNAL OF PUBLIC OPINION RESEARCH},
Year = {2025},
Volume = {37},
Number = {2},
Month = {SUM},
Abstract = {This study aims to empirically examine individual attitudes toward
   transitional justice (TJ), especially focusing on how the Big Five
   personality traits influence individual perceptions of TJ. Using the
   original survey data collected in Taiwan, this study finds that
   personality traits exert some influence on different aspects of
   attitudes toward TJ. Among the 5 personality traits, openness to
   experience has a more significant and consistent effect on individual
   attitudes toward TJ. People with higher levels of openness to experience
   tend to support most TJ measures. Besides, the results from the
   experimental design reveal that different narratives of TJ would affect
   individual support for TJ. Overall, this study provides the theoretical
   foundation and empirical evidence for a psychological explanation of
   individual attitudes toward TJ and makes some significant contributions
   to the study of TJ.},
Publisher = {OXFORD UNIV PRESS},
