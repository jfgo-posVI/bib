@article{ WOS:001497295000001,
Author = {Pinhal, Ruben and Estima, Ana and Duarte, Paulo},
Title = {See, like, and book: Eye-tracking the power of visual attention in
   destination marketing},
Journal = {JOURNAL OF MARKETING COMMUNICATIONS},
Year = {2025},
Month = {2025 MAY 28},
Abstract = {As social media redefines tourism marketing, visual content is crucial
   in attracting visitors to cultural destinations. This study employs
   eye-tracking technology to analyze how tourists visually engage with
   images of UNESCO Creative Cities, identifying key attributes that
   capture attention. Using the Gazepoint GP3 device, the study examined
   participants' eye movements, viewing curated city images, assessing
   fixation patterns, revisits, and preference selection. Findings revealed
   that color, landscape, architecture, and cultural elements significantly
   impact visual attention, often diverging from explicitly stated
   preferences. While participants showed interest in images featuring
   natural scenery and vibrant urban aesthetics, subconscious engagement
   with culturally significant symbols was also evident. These insights
   offer data-driven strategies for municipalities to optimize visual
   storytelling, particularly on social media platforms like Instagram. The
   study contributes to tourism branding theory, emphasizing the interplay
   between cognitive perception and subconscious attraction in digital
   destination promotion.},
