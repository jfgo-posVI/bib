@incollection{ WOS:000876315000005,
Author = {Chow, Pei-Sze},
Book-Author = {Chow, P},
Title = {Copenhagen Dreaming: Navigating the Urban City},
Booktitle = {TRANSNATIONAL SCREEN CULTURE IN SCANDINAVIA: Mediating Regional Space
   and Identity in the Oresund Region},
Series = {Palgrave European Film and Media Studies},
Year = {2021},
Pages = {77-101},
Abstract = {Focusing on Dromme i Kobenhavn (Copenhagen Dreams, 2009), a poetic
   documentary by Danish filmmaker Max Kestner, this chapter analyses the
   film's depiction of the labyrinth of urban Copenhagen, a capital city
   seemingly assured of its own identity yet also undergoing incremental
   changes to its urban texture. The film navigates a path through the
   dreams and inner musings of its inhabitants in everyday contexts and
   spaces, contrasting these narratives with visual explorations of the
   larger built environment and the ongoing (re)construction processes
   throughout the city, many of which are related to the broader Oresund
   project (e.g. Orestad). This documentary mediates a different attitude
   towards the transnational regional imaginary-one of slight indifference
   and distance.},
