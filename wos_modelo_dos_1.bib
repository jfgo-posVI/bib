@article{ WOS:001564195200001,
Author = {Ness-Maddox, Heather and Magliano, Joseph P.},
Title = {Processing of Facial Information Related to Emotional Inferences During
   Reading of Text and Graphic Narratives},
Journal = {MEDIA PSYCHOLOGY},
Year = {2025},
Month = {2025 SEP 3},
Abstract = {We investigated the extent to which media affords emotional inferences.
   We first test media affordances for emotional inferences between text
   and graphic narratives and then test features of each medium to support
   the generation of emotional inferences. For graphic narratives, we
   investigated varying shot scales of panels to highlight characters'
   facial expressions, and for text narratives, we investigated the
   explicit descriptions of characters' facial expressions. We analyzed
   archival verbal protocol data from a study in which students at a
   university in the Southeastern United States thought aloud while reading
   text and non-linguistic graphic versions of narratives. Participants' (N
   = 51) verbal protocols at the sentence and panel level were coded for
   the presence of an emotional inference. Participants were more likely to
   generate an emotional inference for the graphic narratives compared to
   the corresponding text narratives. For graphic narratives, participants
   were more likely to generate an emotional inference for panels that
   closely frame characters' faces (i.e. extreme close-up, close-up, and
   medium close-up shots). For text narratives, participants were more
   likely to generate an emotional inference when a facial expression was
   explicitly described. Both text and graphic narratives can prompt
   readers' activation of knowledge related to emotion by highlighting
   characters' facial expressions through the features of that medium.},
