@article{ WOS:001565146800001,
Author = {Kumar, Anilesh},
Title = {Monologues as epistemic sites of nationalist narrative construction: A
   case study of India's Republic TV},
Journal = {JOURNAL OF INTERNATIONAL AND INTERCULTURAL COMMUNICATION},
Year = {2025},
Month = {2025 SEP 3},
Abstract = {In contrast to the literature on nationalist narrative construction by
   the media during significant events such as wars and terrorist attacks,
   this study investigates the deployment of nationalist tropes in everyday
   stories. It focuses on monologues that blur the ``sacred{''} boundary
   between news and views, examining the editorialisation of stories
   against the backdrop of rising right-wing nationalist politics and the
   BJP government's increasing control over mainstream TV news in India.
   Monologues from one of India's most-watched English-language news
   channels - Republic TV - were selected for analysis. The study employed
   a set of frameworks for analysing the data: nationalism as a contextual
   framework and ``banal nationalism{''} as a theoretical framework.
   Combining computer-assisted textual analysis with qualitative thematic
   analysis, the study reveals two major nationalist tropes on prime-time
   news every day: (i) opposition parties as ``anti-national{''}, and (ii)
   foreign conspiracy against the motherland. This study of 346 episodes
   concludes that (a) monologues, through a dramatic presentation style,
   attempt to manufacture a sense of nationalism daily and (b) reminders of
   nationalism are not subtle and ``banal{''} but often aggressive and
   virulent.},
