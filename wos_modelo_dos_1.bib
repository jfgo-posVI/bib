@article{ WOS:000760386200001,
Author = {Tabernero, Carlos},
Title = {Wildlife comics, or the making of young naturalists in late Franco's
   Spain (1969-1970)},
Journal = {JCOM-JOURNAL OF SCIENCE COMMUNICATION},
Year = {2022},
Volume = {21},
Number = {1},
Abstract = {This essay examines a highly popular comic series published in Spain
   between 1969 and 1970 which focused on Felix Rodriguez de la Fuente
   (1928-1980), a prominent and influential naturalist and media icon, as
   main character. These comics constitute a remarkably illustrative
   example of the use of popular media in processes of construction of
   natural history knowledge. Situated in the complex final years of
   Franco's regime, they allow us to probe the combined role of science,
   media, and celebrity in the construction of a visual environmental
   culture through storytelling strategies designed to engage young
   audiences in naturalist-like practices.},
