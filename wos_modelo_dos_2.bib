@article{ WOS:001538917800001,
Author = {Zhou, Chunfa},
Title = {Nostalgic consumption in digital spaces: understanding youth network
   identity through GG bonds},
Journal = {ASIAN JOURNAL OF COMMUNICATION},
Year = {2025},
Volume = {35},
Number = {5},
Pages = {426-447},
Month = {SEP 3},
Abstract = {Nostalgic consumption among youth has gained increased attention in the
   digital age, yet few studies have explored how online communities
   collectively reshape personal memories. This study addresses that gap by
   examining how Chinese youth develop identity and community through the
   animated character GG Bond, which was originally aimed at children but
   was reappropriated in adulthood. Using qualitative data gathered from
   social media platforms during 2024, thematic and narrative analyses are
   employed to uncover how personal childhood reminiscences are converted
   into shared cultural experiences. The findings demonstrate that
   second-creation practices, interactive commentary, and merchandise
   engagement foster collective identity, emotional relief, and a sense of
   belonging among Gen Z consumers. By highlighting how digital
   infrastructure transforms nostalgia into an active, networked
   phenomenon, this study advances our understanding of participatory
   culture and youth identity. The results offer broader implications for
   consumer culture theory, media studies, and digital marketing,
   illustrating the potential of nostalgia to drive community formation and
   brand resonance in online environments.},
