@article{ WOS:001382886100005,
Author = {Syazana, Iylia and Kamarudin, Lina Munirah and Ali, Fitra bin Mohd and
   Adzmi, Azian Muhamad},
Title = {Visual rhetoric and media representation: Crafting inclusive narratives
   in culturally sensitive environments},
Journal = {SEARCH-JOURNAL OF MEDIA AND COMMUNICATION RESEARCH},
Year = {2024},
Volume = {16},
Number = {3},
Pages = {63-78},
Abstract = {As Muslim-friendly spas rise in prominence within the wellness industry,
   aligning this sector with Islamic values and addressing customers'
   cultural and spiritual needs is essential. This study explores how these
   spas utilise visual rhetoric and media representation to develop
   Muslim-friendly environments that resonate with Muslim customers. The
   study provides a comprehensive view of their approaches through
   qualitative research methods, including face-to-face interviews with spa
   operators from four different regions in Malaysia. It examines how
   visual rhetoric elements like gender- segregated area signage, modest
   imagery in marketing, and halal symbols as well as auditory components
   such as soothing soundscapes, Quranic recitations, and courteous verbal
   interactions are used. Analysis using NVIVO 14 identified significant
   themes and practices. The findings offer practical recommendations that
   can benefit Malaysian stakeholders, such as local Islamic authorities
   and cultural advisors, by providing insights into effective practices
   for promoting and validating culturally sensitive spa services. By
   applying these visual rhetoric strategies, spa operators can align their
   services with stakeholder expectations, strengthen their cultural brand,
   and enhance customer satisfaction in the competitive Malaysian wellness
   market. In short, this study offers valuable insights for integrating
   cultural sensitivity into spa operations, benefiting the operators and
   the broader stakeholder community.},
Publisher = {TAYLORS UNIV, SOUTH EAST ASIA RESEARCH CENTRE COMMUNICATION \&
