@article{ WOS:001529730300001,
Author = {Joynes, J. and Kumar, V. Vijay},
Title = {Subaltern resistance and spatial politics in Tamil cinema: decolonising
   neoliberal narratives of poverty},
Journal = {JOURNAL OF MULTICULTURAL DISCOURSES},
Year = {2024},
Volume = {19},
Number = {4},
Pages = {335-353},
Month = {OCT 1},
Abstract = {Mainstream Indian films ignore the experiences of marginalized
   communities, blaming the poor for their situation and supporting
   neoliberal ideas (Roy, A. 2010. Poverty Capital: Microfinance and the
   Making of Development. London: Routledge; Wacquant, L. 2020. Punishing
   the Poor: The Neoliberal Government of Social Insecurity. Durham, NC:
   Duke University Press). This study examines Madras (2014) and Vada
   Chennai (2018, transl. North Chennai) as critiques of neoliberal
   visuals, using vernacular forms to reclaim marginalised spaces and frame
   poverty as structural violence through subaltern resistance. This study
   employs qualitative textual analysis within a postcolonial framework
   (Bhabha, H. K. 1994. The Location of Culture. London: Routledge; Spivak,
   G. C. 1988. ``Can the Subaltern Speak?{''} In Marxism and the
   Interpretation of Culture, edited by C. Nelson and L. Grossberg,
   271-313). Urbana: University of Illinois Press) to show how Tamil films
   challenge neoliberal poverty ideals, reclaim oppressed spaces as
   resistance (Sassen, S. 2014. Expulsions: Brutality and Complexity in the
   Global Economy. Cambridge, MA: Harvard University Press), and expose
   intersectional caste-class violence (Crenshaw, K. W. 2013. ``Margins:
   Intersectionality, Identity Politics, and Violence Against Women of
   Color.{''} In The Public Nature of Private Violence, 93-118. London:
   Routledge), advancing decolonial narratives centred on vulnerable
   subalterns in the Global South.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
