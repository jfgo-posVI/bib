@article{ WOS:001549256800001,
Author = {Kumar, Anilesh and Bhat, Prashanth},
Title = {Reluctant Journalism: How Indian Journalists Navigate the Role
   Conception-Performance Gap in a Polarized Media Landscape},
Journal = {JOURNALISM PRACTICE},
Year = {2025},
Month = {2025 AUG 13},
Abstract = {This qualitative research, based on semi-structured interviews with 25
   journalists associated with India's Republic TV, probes into the
   challenges of working within an editorial framework that prioritizes
   nationalist narratives. By using constructionist interviewing
   techniques, the study draws on journalists' perspectives about their
   professional roles, editorial influences, and the institutional
   pressures of producing polarizing content. Thematic analysis of the
   interview data reveals three significant themes: (i) a ``dissociated
   association with nationalist narratives,{''} where journalists voice
   dissonance between their values and editorial directives; (ii)
   ``polarizing journalism for polarized times,{''} which reflects a
   growing alignment of journalism with divisive ideologies; and (iii)
   ``journalism as a routine job,{''} indicating professional fatigue in a
   constricted media environment. This study contributes to scholarship on
   journalistic autonomy by illustrating how a ``professional realism{''}
   emerges in nationalist media spaces, where journalists negotiate between
   personal ideals and organizational demands. The research thus advances
   the understanding of journalistic role perception in ideologically
   restricted newsrooms, underscoring the implications for democratic
   discourse and media diversity in India's increasingly polarized media
   landscape.},
