@article{ WOS:001514248500005,
Author = {Al-Rawi, Ahmed},
Title = {Trolling the Messenger: Visual Disinformation Targeting CNN and Fox News},
Journal = {VISUAL COMMUNICATION QUARTERLY},
Year = {2025},
Volume = {32},
Number = {2},
Pages = {105-128},
Month = {APR 3},
Abstract = {In this empirical study, I investigate the use of visual disinformation
   sent by trolls that targeted CNN and Fox News. I argue that trolls try
   to attain access into national online spaces through social media to
   propagate political narratives that align with their political agendas.
   Based on the theoretical framework around networked authoritarianism and
   trolling, the findings of the study show that Russian trolls were the
   most active in attacking these two news organizations, followed by
   Iranian trolls. However, there seems to be an ideological divide, as
   Russian trolls overwhelmingly targeted CNN with accusations of
   disinformation and fake news as well as using numerous humorous memes,
   unlike the case of Fox News. Iranian trolls, however, targeted the two
   channels by paying more attention to negative messages toward Fox News.
   Although the tweets were limited, Arab trolls from Saudi Arabia, the
   U.A.E., and Egypt only targeted CNN with negative memes and messages,
   whereas Chinese trolls focused more on Fox News in terms of negative
   attacks.},
