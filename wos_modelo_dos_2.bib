@article{ WOS:001391127100001,
Author = {Hasfi, Nurul and Fisher, Micah R.},
Title = {Narrating Vulnerability and Reshaping Resilience: Media Discourse and
   Political Coalitions on Jakarta Flooding},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2025},
Volume = {19},
Number = {4},
Pages = {688-706},
Month = {MAY 19},
Abstract = {Floods in Jakarta are increasing in severity. Most research explaining
   this phenomenon centers on biophysical and normative dimensions, with
   occasional historicized explanations. This article shifts focus to the
   dynamic contemporary narratives of assigning blame and legitimating
   solutions. We do this by first categorizing flood causes represented in
   the media in 2019, which spotlight a combination of distal explanations
   like climate change, specific sectoral issues like waste and subsidence,
   and systemic challenges such as poor planning. Applying an advocacy
   coalition framework and discourse network analysis, we thereafter map
   out narratives and actors across influential media outlets to visualize
   corresponding political networks. Findings illustrate media agendas
   fracturing across dominant groups and clustering into actor coalitions
   divided across two themes, namely ``normalization{''} or
   ``naturalization{''}. Moreover, mainstream media analysis of cluster
   formations assists in illuminating notions of vulnerability and
   resilience. Positions rarely remain fixed, however, reinforcing the
   expansive opportunities of tracking discursive politics in the media.},
