@article{ WOS:001525971000001,
Author = {Pan, Xuanchen and Li, Ying and Chen, Yongkang},
Title = {Exploring the Impact of Augmented Reality Picture Book Design
   Characteristics on Adult Readers' Purchase Intentions},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER INTERACTION},
Year = {2025},
Month = {2025 JUL 9},
Abstract = {With the rapid development of augmented reality (AR) technology, AR
   picture books have new development possibilities, yet limited research
   exists on the purchase intention of adult readers of AR picture books.
   Based on the information system success model and the perceived value
   theory, this study integrates the design features of AR picture books
   into causal configuration, and constructs a structural model using
   perceived emotional value and perceived functional value as the
   intermediary variables. Based on the valid data of 327 adult readers,
   partial least squares structural equation modeling (PLS-SEM) was used to
   empirically analyze the structural model. The results show that
   aesthetic quality, interaction quality, information quality and
   narrative quality are the key factors affecting purchase intention, and
   perceived emotional value and perceived functional value play a
   mediating role. The results of this study provide rich theoretical and
   practical insights for the design and marketing strategies of AR picture
   books.},
