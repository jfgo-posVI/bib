@article{ WOS:001487966600001,
Author = {Saliu, Hasan},
Title = {The critical need for public relations literacy in a post-truth era},
Journal = {COMMUNICATION RESEARCH AND PRACTICE},
Year = {2025},
Volume = {11},
Number = {2},
Pages = {221-232},
Month = {APR 3},
Abstract = {This paper examines the overlooked distinction between media literacy
   and public relations (PR) literacy, emphasizing PR's substantial
   influence on media content. Although PR and journalism are historically
   and contemporarily intertwined, their differing purposes necessitate
   distinct analytical frameworks. The study reveals that media literacy,
   in both classical and contemporary scholarship, largely neglects PR's
   role, leading to a significant gap in understanding contemporary
   communication dynamics. By critically analyzing PR's influence on media
   narratives, this paper argues that media literacy fails to address the
   specificities and complexities of PR literacy. It calls for a more
   focused approach to PR literacy as an independent field, particularly in
   light of post-truth dynamics, mob censorship, and the increasing impact
   of artificial intelligence as both a messenger and a communicative actor
   in PR.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
