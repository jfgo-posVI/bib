@article{ WOS:001378368600012,
Author = {Guisande, Miguel angel Alonso and Fraile, Luis Antonio Lopez},
Title = {Generación de audio procedural en el videojuego No
   Man's Sky: análisis del diseño sonoro narrativo},
Journal = {HIPERTEXT NET},
Year = {2024},
Number = {29},
Pages = {149-159},
Month = {NOV},
Abstract = {The study of video games, in all of their various forms, and their
   impact on society has proven to be of great strategic importance in
   understanding the current digital context. The exponential growth
   experienced by the sector worldwide in the last decade in terms of the
   number of video game productions, consumers and economic data justifies
   this. The development and technical production of video games is in a
   constant state of evolution due to the successive hardware and software
   innovations used in their implementation, which grant new narrative
   possibilities. This study, which focuses on the analysis of sound and
   its potential for narrative expression, presents a series of ideas and
   reflections that aim to enhance understanding of the digital culture of
   video games. It is based on an examination of the sound design of the
   procedural video game No Man's Sky, which has gained international
   recognition for its rich, infinite gameplay due to its implementation
   through procedural algorithms. The research employs a case analysis
   methodology, as exemplified by the video game previously mentioned, to
   conduct a sound analysis based on the fundamental variables identified
   in the sound universe of the video game. Finally, a bibliographical
   approach is made to the relationship between procedural technology and
   artificial intelligence.},
