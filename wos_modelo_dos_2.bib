@article{ WOS:001027211900012,
Author = {Alvarez-Rodriguez, Victor and Jimenez-Marin, Gloria},
Title = {Where everybody knows your name. Fictional brands as a distinctive
   identity},
Journal = {TEKNOKULTURA: REVISTA DE CULTURA DIGITAL Y MOVIMIENTOS SOCIALES},
Year = {2023},
Volume = {20},
Number = {2},
Pages = {269-276},
Abstract = {This paper analyses the Cheers brand using a communicative and marketing
   tool called `reverse product placement'. This type of analysis explores
   efforts by advertisers and companies to exploit and develop fictional
   brands as an element of identity in audio-visual narrative fiction and
   in the business sphere, be that in the offline domain and/or the
   metaverse. The research design included a literature review, an in-depth
   interview, and a qualitative case study analysis. The results show the
   high communicative potential of audio-visual fiction to generate brand
   identity, loyalty, and engagement in real markets and in digital
   culture.},
