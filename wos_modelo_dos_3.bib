@article{ WOS:000828871100009,
Author = {Rebollo-Bueno, Sara},
Title = {The use of fear-inducing propaganda strategies and techniques in
   audio-visual dystopias. The case of Gilead in The Handmaid's Tale},
Journal = {DOXA COMUNICACION},
Year = {2022},
Number = {35},
Pages = {149-164},
Month = {JUL-DEC},
Abstract = {The present study addresses the use of fear-generating strategies and
   techniques related to the theory of propaganda in audiovisual
   productions, focusing on the analysis of the dystopian series known as
   The Handmaid's Tale. Although fear is commonly used in propaganda as a
   tool for social control and political domination, this study questions
   whether it is used in the political systems represented in audio-visual
   dystopias, as these are reflections of current fears of a catastrophic
   future. To achieve the objective, this study uses content analysis
   applied to the first three seasons of the aforementioned series
   involving scenes in which Fred Waterford, Serena Joy, and Aunt Lydia
   appear in the narrative as representatives of Gilead.},
Publisher = {UNIV SAN PABLO, FAC HUMANIDADES \& CIENCIAS COMUNICACION},
