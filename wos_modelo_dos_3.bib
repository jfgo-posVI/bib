@article{ WOS:001537452500001,
Author = {Iddrisu, Fuseini and Nutsugah, Noel and Onomah, Derek and Essandoh,
   Mavis},
Title = {Did the West introduce public relations to Africa? Narratives from the
   Akan indigenous palace practices},
Journal = {ANNALS OF THE INTERNATIONAL COMMUNICATION ASSOCIATION},
Year = {2025},
Volume = {49},
Number = {3},
Pages = {216-227},
Month = {SEP},
Abstract = {A critical look at the extant literature on the history of public
   relations (PR) in Africa indicates that the phenomenon started only when
   the Europeans arrived. These historical narratives ignore PR principles
   that can be found in the indigenous practices of most traditions in
   Africa. This study embarks on a critical scholarship guided by in-depth
   interviews, focus group discussions, observations, and video data to
   argue that there exist PR principles in Akan indigenous palace
   communication that predate the arrival of the Europeans. Specifically,
   the study found several indigenous activities that connote strategic
   image construction, relationship-building and management, general
   communication concepts, and media relations function, all of which are
   core to PR management. Based on the above, the study developed an Akan
   PR model that depicts notable PR principles within the milieu of Akan
   palace communication in an attempt to retell the history of PR in a
   non-westernized context. This study holds scholarship and pedagogical
   significance for magnifying other voices in the evolution of PR. This is
   achieved by explicating that traditional African governance structures
   have long employed strategic communication, relationship management, and
   reputation management principles.},
Publisher = {OXFORD UNIV PRESS},
Address = {GREAT CLARENDON ST, OXFORD OX2 6DP, ENGLAND},
Type = {Article},
Language = {English},
