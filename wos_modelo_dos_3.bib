@article{ WOS:000542035700001,
Author = {LeMasters, Katherine and Dussault, Josee and Barrington, Clare and
   Bengtson, Angela and Gaynes, Bradley and Go, Vivian and Hosseinipour,
   Mina C. and Kulisewa, Kazione and Kutengule, Anna and Meltzer-Brody,
   Samantha and Midiani, Dalitso and Mphonda, Steve and Udedi, Michael and
   Pence, Brian},
Title = {``Pain in my heart{''}: Understanding perinatal depression among women
   living with HIV in Malawi},
Journal = {PLOS ONE},
Year = {2020},
Volume = {15},
Number = {6},
Month = {JUN 5},
Abstract = {Background
   Perinatal depression (PND) can interfere with HIV care engagement and
   outcomes. We examined experiences of PND among women living with HIV
   (WLWH) in Malawi.
   Methods
   We screened 73 WLWH presenting for perinatal care in Lilongwe, Malawi
   using the Edinburgh Postnatal Depression Scale (EPDS). We conducted
   qualitative interviews with 24 women experiencing PND and analyzed data
   using inductive and deductive coding and narrative analysis.
   Results
   Women experienced a double burden of physical and mental illness,
   expressed as pain in one's heart. Receiving an HIV diagnosis
   unexpectedly during antenatal care was a key contributor to developing
   PND. This development was influenced by stigmatization and social
   support.
   Conclusions
   These findings highlight the need to recognize the mental health
   implications of routine screening for HIV and to routinely screen and
   treat PND among WLWH. Culturally appropriate mental health interventions
   are needed in settings with a high HIV burden.},
