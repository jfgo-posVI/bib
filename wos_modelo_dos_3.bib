@article{ WOS:001566856700003,
Author = {Ciselli, Graciela and Cruz, Sergio Santa and Vazquez, Alberto Daniel and
   Rasjido, Julia Veronica},
Title = {Puerto Visser: between the imagined and geo-historical data},
Journal = {INFORMES CIENTIFICOS Y TECNICOS},
Year = {2025},
Volume = {17},
Number = {2},
Pages = {48-62},
Abstract = {On April 28, 1902, the Escalante Colony Reserve was created and land was
   granted to families from South Africa who arrived in successive
   contingents between 1902 and 1907. Two of them were led by Conrado
   Visser. In the colony they dedicated themselves to the cultivation of
   vegetables and fruit trees and sheep farming, highlighting the need for
   their own port that would resolve their rapid contact with the outside
   world. Since the ports of Camarones and Comodoro Rivadavia were far
   away, Conrado Visser interested the Ministry of the Navy so that the An
   \& oacute;nima and Lahusen ships could call there. So, from 1912 until
   the beginning of the 1940s, a site functioned as a pier called Puerto
   Vissser. The objectives of this paper are to investigate the role that
   Puerto Visser had as a place of embarkation and disembarkation of the
   Escalante colony during the first half of the 20th century to confront,
   based on the material remains and the existing narratives about it, with
   the imagined constructions. In this article we present the results
   obtained from the bibliographic review referring to the colony, the
   analysis of historical sources (newspapers, legislation, photographs,
   official bulletins, cartography) and the carrying out of field work that
   has allowed field observation, the identification of material vestiges
   on the site and interviews with livestock farmers close to the place.
   With this information, a thematic mapping sequence developed with data
   collected through the use of GPS.},
