@article{ WOS:001385035400001,
Author = {Zhang, Jiajie},
Title = {Pioneering feminist visual language: mako Idemitsu's early works and
   artistic evolution},
Journal = {FEMINIST MEDIA STUDIES},
Year = {2024},
Month = {2024 DEC 29},
Abstract = {Mako Idemitsu, a pioneer of feminist art in Japan, has created
   experimental films and video art since the 1970s, focusing on women's
   experiences, consciousness, and identities. While the academic and
   artistic discourse predominantly emphasizes her dramatic and fictional
   works from the 1980s, this study analyzes three of Idemitsu's early
   works-Women's House, What A Woman Made, and Something Within Me-to trace
   her artistic evolution. Situating these works within the feminist
   movement of the 1970s, the study demonstrates that, formally, Idemitsu's
   counter-cinema narrative structures convey psychological states and
   challenges traditional depiction of reality, while thematically, her art
   criticizes social norms and expectations imposed on women, visualizing
   their dual oppression in family and societal contexts. The study details
   the development of Idemitsu's visual language, characterized by
   abstraction and symbolic imagery, and reevaluates her early works as
   both media exploration and feminist practice. It concludes that these
   works expand the role of film and video as feminist media in
   deconstructing gender-stereotyped representations of women's experience
   and integrate feminist ideas into Japan's cultural landscape.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
