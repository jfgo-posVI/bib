@incollection{ WOS:001142929600010,
Author = {Konrad, Tatiana},
Book-Author = {Karshner, K},
Title = {LGBTQ Graphic Novels for/about Teenagers: Adolescence and Queerness in
   Honor Girl \& Adrian and the Tree of Secrets},
Booktitle = {VOICES FROM THE WRECKAGE: Young Adult Voices in the MeToo Movement},
Series = {Series in Sociology},
Year = {2023},
Pages = {167-182},
Abstract = {This essay explores how graphic narratives portray queerness, focusing
   specifically on the period of adolescence, as a traumatic experience. It
   examines the representations of lesbian and gay teenagers in Maggie
   Thrash's graphic memoir Honor Girl (2015) and Hubert and Marie Caillou's
   graphic novel Adrian and the Tree of Secrets (2014). These narratives
   reveal that through the support of friends and family, queerness can be
   accepted and celebrated as one of many forms of identity. The trauma
   that teenagers experience, as these narratives illustrate, emerges not
   due to the protagonists' own way of perceiving themselves, but through
   the ways in which these individuals are viewed by the outside community,
   including their families, teachers, and friends. The essay pays close
   attention to the verbal and visual techniques that the two graphic
   narratives employ to communicate adolescence and queerness, as well as
   argues that these texts can be used to teach young (and older)
   generations about such issues as tolerance and diversity.},
Publisher = {Vernon Press},
Address = {1000 N West Street, Ste 1200, Wilmington, DE, UNITED STATES},
Type = {Article; Book Chapter},
Language = {English},
