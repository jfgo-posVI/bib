Month = {JAN},
Abstract = {This paper addresses the contribution of data to the construction of
   brand stories. It is analyzed. thus. how storytelling, enhanced by the
   use of data, can help generating consumer engagement and constructing
   creative advertising messages. To that end. `Creative Data Lions{''}
   category -and, in particular, all the campaigns selected in Tata
   storytelling' section- of Cannes Lions advertising festival is used. The
   results allow us to observe that this is an enormously diverse trend,
   with data fulfilling very diverse roles in relation to storytelling.},
